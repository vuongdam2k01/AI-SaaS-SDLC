{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI SaaS SDLC Current State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "active_baseline", "evidence_revision", "next_change", "next_flow", "next_execution", "id_registry"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "active_baseline": { "anyOf": [{ "type": "string", "pattern": "^BL-[0-9]{3,}$" }, { "type": "null" }] },
    "evidence_revision": { "type": "integer", "minimum": 0 },
    "next_change": { "type": "integer", "minimum": 1 },
    "next_flow": { "type": "integer", "minimum": 1 },
    "next_execution": { "type": "integer", "minimum": 1 },
    "id_registry": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9-]*$" }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "question_first_baseline": { "type": "object", "propertyNames": { "pattern": "^QST-[A-Z0-9-]+$" }, "additionalProperties": { "type": "string", "pattern": "^BL-[0-9]{3,}$" } },
    "next_retrieval": { "type": "integer", "minimum": 1 },
    "next_query": { "type": "integer", "minimum": 1 }
  }
}
