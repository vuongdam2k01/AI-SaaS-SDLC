{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vuongdam2k01/AI-SaaS-SDLC/schemas/execution-record.schema.json",
  "title": "AI SaaS SDLC Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "flow_id", "level", "command_id", "command", "cwd", "started_at", "ended_at", "exit_code", "output_hash", "output_file", "git_commit", "source_snapshot_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^EXEC-[0-9]{3,}$" },
    "flow_id": { "type": "string", "pattern": "^FLOW-[0-9]{3,}$" },
    "level": { "enum": ["unit", "integration", "system"] },
    "command_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "command": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "exit_code": { "type": "integer" },
    "output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_file": { "type": "string", "pattern": "^\\.ai-saas-sdlc/executions/EXEC-[0-9]{3,}\\.log$" },
    "git_commit": { "type": ["string", "null"] },
    "source_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "arch", "node"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "timed_out": { "type": "boolean" },
    "output_truncated": { "type": "boolean" },
    "spawn_error": { "type": "boolean" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "hash", "total", "passed", "failed", "skipped"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["junit", "tap"] },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "report_error": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "time_ms", "spec_id", "case_ids"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "time_ms": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "spec_id": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" }, { "type": "null" }] },
          "case_ids": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^TC-[0-9]+$" } }, { "type": "null" }] }
        }
      }
    }
  }
}
