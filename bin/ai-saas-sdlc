  /\bos\.[Gg]etenv\(\s*["']([A-Z][A-Z0-9_]*)["']/g,
  /\bSystem\.getenv\(\s*["']([A-Z][A-Z0-9_]*)["']/g,
  /\benv::var(?:_os)?\(\s*["']([A-Z][A-Z0-9_]*)["']/g,
