// src/core/git.ts
import { execFileSync as execFileSync2 } from "node:child_process";
function git2(root2, args) {
  try {
    return execFileSync2("git", args, { cwd: root2, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    return null;
  }
}
function isDirty(root2) {
  const status = git2(root2, ["status", "--porcelain"]);
  return status !== null && status !== "";
}
function gitCommit(root2) {
  const head = git2(root2, ["rev-parse", "HEAD"]);
  if (head === null) return null;
  return isDirty(root2) ? `${head}+dirty` : head;
}

