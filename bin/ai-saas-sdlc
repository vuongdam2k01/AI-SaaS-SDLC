// src/core/graph.ts
function buildGraph(artifacts) {
  const nodes = artifacts.filter((artifact2) => artifact2.id).map((artifact2) => ({
    id: artifact2.id,
    type: artifact2.artifact_type,
    status: artifact2.status,
    file: artifact2.file,
    depends_on: uniqueSorted(artifact2.depends_on),
    decisions: uniqueSorted(artifact2.decisions),
    supersedes: artifact2.supersedes,
    writes_to: uniqueSorted(artifact2.writes_to),
    implementation: uniqueSorted(artifact2.implementation)
  })).sort((a, b) => a.id.localeCompare(b.id));
  const edges = nodes.flatMap((node) => [
    ...node.depends_on.map((target) => ({ from: node.id, to: target, relation: "depends_on" })),
    ...node.decisions.map((target) => ({ from: node.id, to: target, relation: "decision" })),
    ...node.writes_to.map((target) => ({ from: node.id, to: target, relation: "writes_to" })),
    ...node.supersedes ? [{ from: node.id, to: node.supersedes, relation: "supersedes" }] : []
  ]).sort((a, b) => `${a.from}:${a.to}:${a.relation}`.localeCompare(`${b.from}:${b.to}:${b.relation}`));
  return { schema_version: 1, nodes, edges };
}
function reverseClosure(graph, seeds) {
  const reverse = /* @__PURE__ */ new Map();
  const convergenceForward = /* @__PURE__ */ new Map();
  const contractTypes = /* @__PURE__ */ new Set(["openapi_contract", "physical_schema", "screen_transitions"]);
  const typeById = new Map(graph.nodes.map((node) => [node.id, node.type]));
  for (const edge of graph.edges) {
    const values = reverse.get(edge.to) ?? /* @__PURE__ */ new Set();
    values.add(edge.from);
    reverse.set(edge.to, values);
    if (edge.relation === "writes_to" || edge.relation === "supersedes" || edge.relation === "depends_on" && contractTypes.has(typeById.get(edge.from) ?? "")) {
      const targets = convergenceForward.get(edge.from) ?? /* @__PURE__ */ new Set();
      targets.add(edge.to);
      convergenceForward.set(edge.from, targets);
    }
  }
  const seen = new Set(seeds);
  const queue = [...seen];
  while (queue.length > 0) {
    const current = queue.shift();
    if (!current) continue;
    for (const dependent of reverse.get(current) ?? []) {
      if (!seen.has(dependent)) {
        seen.add(dependent);
        queue.push(dependent);
      }
    }
    for (const convergence of convergenceForward.get(current) ?? []) {
      if (!seen.has(convergence)) {
        seen.add(convergence);
        queue.push(convergence);
      }
    }
  }
  return [...seen].sort((a, b) => a.localeCompare(b));
}
function topologicalOrder(graph) {
  const nodes = new Set(graph.nodes.map((node) => node.id));
  const indegree = new Map([...nodes].map((id2) => [id2, 0]));
  const outgoing = /* @__PURE__ */ new Map();
  const counted = /* @__PURE__ */ new Set();
  for (const edge of graph.edges.filter((item) => (item.relation === "depends_on" || item.relation === "writes_to") && nodes.has(item.to))) {
    const pair = `${edge.from}\0${edge.to}`;
    if (counted.has(pair)) continue;
    counted.add(pair);
    indegree.set(edge.from, (indegree.get(edge.from) ?? 0) + 1);
    const values = outgoing.get(edge.to) ?? /* @__PURE__ */ new Set();
    values.add(edge.from);
    outgoing.set(edge.to, values);
  }
  const ready = [...nodes].filter((id2) => (indegree.get(id2) ?? 0) === 0).sort();
  const order = [];
  while (ready.length > 0) {
    const id2 = ready.shift();
    if (!id2) continue;
    order.push(id2);
    for (const dependent of outgoing.get(id2) ?? []) {
      const next = (indegree.get(dependent) ?? 1) - 1;
      indegree.set(dependent, next);
      if (next === 0) {
        ready.push(dependent);
        ready.sort();
      }
    }
  }
  return { order, cycles: [...nodes].filter((id2) => !order.includes(id2)).sort() };
}
