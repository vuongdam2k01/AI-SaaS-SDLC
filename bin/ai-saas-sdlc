// src/core/firecrawl.ts
var firecrawl_exports = {};
__export(firecrawl_exports, {
  detectFirecrawlVersion: () => detectFirecrawlVersion,
  firecrawlCrawl: () => firecrawlCrawl,
  firecrawlMap: () => firecrawlMap,
  firecrawlReady: () => firecrawlReady,
  firecrawlScrape: () => firecrawlScrape
