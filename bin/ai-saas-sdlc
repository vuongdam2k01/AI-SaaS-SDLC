// src/core/implementation-projections.ts
function table2(headers3, rows) {
  const head = `| ${headers3.join(" | ")} |`;
  const divider = `| ${headers3.map(() => "---").join(" | ")} |`;
  const body = rows.length > 0 ? rows.map((row) => `| ${row.join(" | ")} |`).join("\n") : `| ${headers3.map(() => "\u2014").join(" | ")} |`;
  return `${head}
${divider}
${body}
`;
}
function cell4(values) {
  return values.length > 0 ? values.map((value) => `\`${value}\``).join(", ") : "\u2014";
}
function projectionCell(value) {
  return value.replaceAll("|", "\\|");
}
function implementationCoverageProjection(artifacts, graph, config, records, drifted) {
  const states = activeFeatures(artifacts).map((feature) => featureImplementationState(feature, artifacts, graph));
  const featureRows = states.map((state) => {
    const unproven = unprovenLevels(state).map(({ level }) => level);
    const mappingState = !state.anyOwnMapped ? "unmapped" : unproven.length > 0 ? `partial: ${unproven.join(", ")} unproven` : "fully mapped";
    const ownMappings = [...state.mapped, ...state.levels.flatMap(({ mapped }) => mapped)].flatMap((artifact2) => artifact2.implementation);
    const driftCount = drifted ? ownMappings.filter((mapping) => drifted.has(mapping)).length : null;
    return [
      `\`${state.feature.id}\``,
      `${state.mapped.length}/${state.mappable.length}`,
      ...state.levels.map(({ specs, mapped }) => specs.length === 0 ? "\u2014" : `${mapped.length}/${specs.length}`),
      driftCount === null ? "\u2014" : driftCount === 0 ? "none" : `${driftCount} mapping(s)`,
      mappingState
    ];
  });
  const commandRows = CONFIG_LEVELS.flatMap(
    ({ key, label }) => config.verification[key].map((command) => {
      const latest = latestExecution(records.filter((record2) => record2.level === key && matchesDefinitionEvidence(record2, command)));
      const cases = latest?.report ? `${latest.report.passed}/${latest.report.failed}/${latest.report.skipped}` : "\u2014";
      return [
        label,
        `\`${command.id}\``,
        latest ? `\`${latest.id}\`` : "none",
        latest ? String(latest.exit_code) : "\u2014",
        cases,
        latest ? latest.ended_at : "\u2014"
      ];
    })
  );
  const seen = /* @__PURE__ */ new Set();
  const unmapped = [];
  for (const state of states) {
    for (const candidate of state.mappable) {
      if (candidate.implementation.length > 0 || seen.has(candidate.id)) continue;
      seen.add(candidate.id);
      const features = states.filter((other) => other.closureIds.has(candidate.id)).map((other) => other.feature.id);
      unmapped.push([`\`${candidate.id}\``, candidate.artifact_type, cell4(features)]);
    }
  }
  unmapped.sort((a, b2) => (a[0] ?? "").localeCompare(b2[0] ?? ""));
  return `# Implementation Coverage

Mapping states derive through the same predicates as the IMPLEMENTATION_MAPPING_MISSING and IMPLEMENTATION_LEVEL_UNPROVEN warnings, so this view never disagrees with a finding. A mapping is a declared path, not a verdict; execution evidence lives in the commands table and in RESULT records. Drift counts mappings whose file content left the baseline behind while their artifacts did not \u2014 the IMPLEMENTATION_DRIFT predicate.

## Features

${table2(
    ["Feature", "Design mapped", "UT specs mapped", "IT specs mapped", "ST specs mapped", "Drift", "Mapping state"],
    featureRows
  )}
## Configured commands

A row matches executions through the same predicate the baseline verdict uses \u2014 identical command identity, text, working directory and platform declaration \u2014 but looks across every flow: latest evidence ever, not latest in the active flow. Cases show passed/failed/skipped from the command's declared report when one is ingested.

${table2(
    ["Level", "Command", "Latest matching execution", "Exit code", "Cases (P/F/S)", "Finished at"],
    commandRows
  )}
## Unmapped active design artifacts

${table2(["Artifact", "Type", "In closure of"], unmapped)}`;
}
function testCaseTableLines(body) {
  const normalized = body.replace(/\r\n/g, "\n");
  const section = normalized.split(/^## Test cases\s*$/m)[1];
  if (!section) return [];
  const untilNextHeading = section.split(/^## /m)[0] ?? "";
  return untilNextHeading.split("\n").filter((line) => line.trimStart().startsWith("|"));
}
function implementationPlanProjections(artifacts, graph, config) {
  const projections = {};
  const byId = new Map(artifacts.map((artifact2) => [artifact2.id, artifact2]));
  const order = topologicalOrder(graph).order;
  const foundations = FOUNDATION_REFERENCES.map((reference) => ({
    ...reference,
    artifact: artifacts.find((artifact2) => artifact2.artifact_type === reference.artifactType)
  }));
  for (const feature of activeFeatures(artifacts)) {
    const state = featureImplementationState(feature, artifacts, graph);
    const closureInOrder = order.filter((id2) => state.closureIds.has(id2)).map((id2) => byId.get(id2)).filter((artifact2) => Boolean(artifact2));
    const closureRows = closureInOrder.map((artifact2) => [
      `\`${artifact2.id}\``,
      artifact2.artifact_type,
      artifact2.status,
      `\`${artifact2.file}\``,
      artifact2.implementation.length > 0 ? artifact2.implementation.map((mapping) => `\`${projectionCell(mapping)}\``).join(", ") : "\u2014",
      cell4(artifact2.depends_on.filter((dependency) => CONTRACT_DEPENDENCY.test(dependency)))
    ]);
    const closureBodies = closureInOrder.map((artifact2) => artifact2.body).join("\n");
    const foundationSections = foundations.map(({ heading, pattern, artifact: artifact2 }) => {
      const vocabulary = artifact2 ? bodyIds(artifact2.body, pattern) : [];
      const referenced = vocabulary.filter((id2) => new RegExp(`\\b${id2}\\b`).test(closureBodies));
      return `### ${heading}

${referenced.map((id2) => `- \`${id2}\``).join("\n") || "None referenced by this closure."}
`;
    });
    const specSections = IMPLEMENTATION_LEVELS.map(({ level }) => {
      const specs = state.levels.find((candidate) => candidate.level === level)?.specs ?? [];
      const bodies = specs.map((spec) => {
        const lines = testCaseTableLines(spec.body);
        return `#### \`${spec.id}\` \u2014 ${spec.title}

Source: \`${spec.file}\`${spec.implementation.length > 0 ? `
Mapped: ${spec.implementation.map((mapping) => `\`${projectionCell(mapping)}\``).join(", ")}` : "\nMapped: not yet"}

${lines.length > 0 ? `${lines.join("\n")}
` : "No test-case table found.\n"}`;
      });
      return `### ${level}

${bodies.join("\n") || "No active specifications at this level.\n"}`;
    });
    const commandSections = CONFIG_LEVELS.map(({ key, label }) => {
      const commands = config.verification[key];
      if (commands.length === 0) return `- **${label}**: no configured command`;
      return `- **${label}**:
${commands.map((command) => `  - \`${command.id}\`: \`${projectionCell(command.command)}\` (cwd \`${projectionCell(command.cwd)}\`)`).join("\n")}`;
    });
    projections[`implementation-plan/${feature.id}.md`] = `# Implementation Plan: ${feature.id}

${feature.title}

Derived work packet joining this feature's closure in dependency order with its mappings, contract files, referenced foundation rows, covering specifications and configured commands. A view for reading and planning \u2014 the artifacts and contract files own their content, and nothing here is authority or evidence.

## Closure in dependency order

${table2(
      ["Artifact", "Type", "Status", "File", "Implementation mappings", "Contract dependencies"],
      closureRows
    )}
## Foundation rows referenced by this closure

${foundationSections.join("\n")}
## Covering specifications

${specSections.join("\n")}
## Configured verification commands

${commandSections.join("\n")}
`;
  }
  return projections;
}
var CONFIG_LEVELS, CONTRACT_DEPENDENCY;
