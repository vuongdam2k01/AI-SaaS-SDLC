var TEST_TYPES = /* @__PURE__ */ new Set(["unit_test_backend", "unit_test_frontend", "unit_test_job", "integration_test", "system_test"]);
function caseIds(body) {
  const section = sectionBody(body, "Test cases");
  if (!section) return /* @__PURE__ */ new Set();
  return new Set(dataRows(section).filter((row) => completedRow(row) && /^`?TC-[0-9]+`?$/i.test(row[0] ?? "")).map((row) => row[0].replace(/`/g, "").toUpperCase()));
}
function brokenCaseReferences(artifacts) {
  const declared = /* @__PURE__ */ new Map();
  for (const artifact2 of artifacts) {
    if (TEST_TYPES.has(artifact2.artifact_type)) declared.set(artifact2.id, caseIds(artifact2.body));
  }
  const broken = [];
  for (const artifact2 of artifacts) {
    if (!isLiveStatus(artifact2.status)) continue;
    const seen = /* @__PURE__ */ new Set();
    for (const match of artifact2.body.matchAll(/\b([A-Z][A-Z0-9-]*)#(TC-[0-9]+)\b/g)) {
      const [reference, specification, testCase] = [match[0], match[1], match[2]];
      const cases = declared.get(specification);
      if (!cases || cases.has(testCase.toUpperCase()) || seen.has(reference)) continue;
      seen.add(reference);
      broken.push({ reference, specification, file: artifact2.file });
    }
  }
  return broken;
}

// src/core/spec-size.ts
var MAX_CASES_PER_SPEC = 12;
var SPLIT_AXIS = {
  integration_test: "by integration boundary",
  system_test: "by user journey"
};
function specSizeEntries(artifacts) {
  return artifacts.filter((artifact2) => SPLIT_AXIS[artifact2.artifact_type] && isLiveStatus(artifact2.status)).map((artifact2) => {
    const cases = caseIds(artifact2.body).size;
    return {
      id: artifact2.id,
      artifact_type: artifact2.artifact_type,
      file: artifact2.file,
      cases,
      oversized: cases > MAX_CASES_PER_SPEC,
      split_axis: SPLIT_AXIS[artifact2.artifact_type]
    };
  });
}

// src/core/question-ledger.ts
var STALE_AFTER_BASELINES = 3;
function column(columns, name) {
  return columns.map(headingKey).indexOf(headingKey(name));
}
function openQuestions(artifacts) {
  const ledger = artifacts.find((artifact2) => artifact2.artifact_type === "question_ledger");
  if (!ledger) return [];
  const section = sectionBody(ledger.body, "Open questions");
  if (!section) return [];
  const rows = dataRows(section);
  const header = rows.find((row) => column(row, "Question ID") >= 0 && column(row, "Status") >= 0);
  if (!header) return [];
  const idIndex = column(header, "Question ID");
  const statusIndex = column(header, "Status");
  const questionIndex = column(header, "Question");
  const affectedIndex = column(header, "Affected artifacts");
  const questions = /* @__PURE__ */ new Map();
  for (const row of rows) {
    if (!completedRow(row)) continue;
    const id2 = (row[idIndex] ?? "").replace(/[`*]/g, "").trim().toUpperCase();
    if (!/^QST-[A-Z0-9-]+$/.test(id2)) continue;
    if ((row[statusIndex] ?? "").trim().toLowerCase() === "resolved") continue;
    questions.set(id2, {
      id: id2,
      question: (row[questionIndex] ?? "").trim(),
      affected: (row[affectedIndex] ?? "").trim(),
      file: ledger.file
    });
  }
  return [...questions.values()];
}
function baselineNumber(id2) {
  if (!id2) return null;
  const number = Number(id2.slice(3));
  return Number.isInteger(number) ? number : null;
}
function baselinesOpen(firstBaseline, activeBaseline) {
  const first = baselineNumber(firstBaseline);
  const active = baselineNumber(activeBaseline);
  if (first === null || active === null) return null;
  return Math.max(0, active - first);
}

// src/core/validation.ts
var requiredFiles = [
  ...Object.keys(CANONICAL_MARKDOWN),
  "03-design/interfaces/openapi.yaml",
  "03-design/data/schema.dbml",
  "03-design/screen-transitions.mmd"
];
var fixedIdentities = {
  engine_configuration: ["SDLC-CONFIG", "sdlc.config.yaml"],
  openapi_contract: ["OPENAPI-CONTRACT", "03-design/interfaces/openapi.yaml"],
  physical_schema: ["PHYSICAL-SCHEMA", "03-design/data/schema.dbml"],
  screen_transitions: ["SCREEN-TRANSITIONS", "03-design/screen-transitions.mmd"]
};
async function validateProject(root2, artifacts) {
  const findings = [];
  let config = null;
  try {
    config = await loadConfig(root2);
  } catch (error) {
    findings.push({ severity: "error", code: "CONFIG_INVALID", message: String(error) });
  }
  for (const file of requiredFiles) {
    if (!await pathExists(path15.join(root2, file))) findings.push({ severity: "error", code: "REQUIRED_FILE_MISSING", message: `Required file is missing: ${file}`, file });
  }
  if (config) {
    for (const source of config.implementation_sources) {
      const sourceRoot = path15.resolve(root2, source.path);
      if (!await pathExists(sourceRoot)) findings.push({ severity: "error", code: "IMPLEMENTATION_SOURCE_MISSING", message: `Configured implementation source is missing: ${source.id} (${source.path})` });
    }
  }
  const byId = /* @__PURE__ */ new Map();
  for (const artifact2 of artifacts) {
    for (const issue of artifact2.metadata_issues) findings.push({ severity: "error", code: "FRONTMATTER_SCHEMA", message: issue, file: artifact2.file });
    for (const field of ["id", "artifact_type", "title", "status", "created_by_change"]) {
      if (!artifact2[field]) findings.push({ severity: "error", code: "METADATA_REQUIRED", message: `Missing ${field}`, file: artifact2.file });
    }
    if (!/^(?:INIT|GENESIS|FLOW-[0-9]{3,}|CHG-[0-9]{3,})$/.test(artifact2.created_by_change)) findings.push({ severity: "error", code: "CREATION_ID_INVALID", message: `Invalid creation identity: ${artifact2.created_by_change}`, file: artifact2.file });
    if (!/^[A-Z][A-Z0-9-]*$/.test(artifact2.id)) findings.push({ severity: "error", code: "ID_INVALID", message: `Invalid artifact ID: ${artifact2.id}`, file: artifact2.file });
    const allowedStatuses = statusesForArtifactType(artifact2.artifact_type);
    if (!allowedStatuses.includes(artifact2.status)) findings.push({ severity: "error", code: "STATUS_INVALID", message: `Invalid status for ${artifact2.artifact_type}: ${artifact2.status} (expected ${allowedStatuses.join("|")})`, file: artifact2.file });
    if (byId.has(artifact2.id)) findings.push({ severity: "error", code: "ID_DUPLICATE", message: `Duplicate artifact ID: ${artifact2.id}`, file: artifact2.file });
    else byId.set(artifact2.id, artifact2);
    const canonical = CANONICAL_MARKDOWN[artifact2.file];
    if (canonical && (artifact2.id !== canonical[0] || artifact2.artifact_type !== canonical[1])) findings.push({ severity: "error", code: "CANONICAL_IDENTITY_INVALID", message: `${artifact2.file} must be ${canonical[0]} with type ${canonical[1]}`, file: artifact2.file });
    else if (!canonical && CANONICAL_TYPES.has(artifact2.artifact_type)) findings.push({ severity: "error", code: "CANONICAL_LOCATION_INVALID", message: `${artifact2.artifact_type} is a singleton canonical type and cannot appear at ${artifact2.file}`, file: artifact2.file });
    else if (SCALABLE_LOCATIONS[artifact2.artifact_type] && !SCALABLE_LOCATIONS[artifact2.artifact_type].test(artifact2.file)) findings.push({ severity: "error", code: "ARTIFACT_LOCATION_INVALID", message: `${artifact2.artifact_type} cannot appear at ${artifact2.file}`, file: artifact2.file });
    else if (SCALABLE_LOCATIONS[artifact2.artifact_type] && path15.basename(artifact2.file, ".md") !== artifact2.id) findings.push({ severity: "error", code: "ARTIFACT_FILENAME_MISMATCH", message: `${artifact2.id} must use the matching filename ${artifact2.id}.md`, file: artifact2.file });
    else if (FIXED_TYPES.has(artifact2.artifact_type)) {
      const fixed = fixedIdentities[artifact2.artifact_type];
      if (!fixed || artifact2.id !== fixed[0] || artifact2.file !== fixed[1]) findings.push({ severity: "error", code: "FIXED_IDENTITY_INVALID", message: `${artifact2.artifact_type} has an invalid fixed identity`, file: artifact2.file });
    } else if (!SCALABLE_LOCATIONS[artifact2.artifact_type] && !canonical) findings.push({ severity: "error", code: "ARTIFACT_TYPE_UNKNOWN", message: `Unknown artifact type: ${artifact2.artifact_type}`, file: artifact2.file });
    if (artifact2.artifact_type === "architectural_decision" && (!artifact2.adr_status || !ADR_STATUSES.includes(artifact2.adr_status))) {
      findings.push({ severity: "error", code: "ADR_STATUS_INVALID", message: "ADR requires adr_status: proposed|accepted|deprecated|superseded", file: artifact2.file });
    }
  }
  for (const type of CANONICAL_TYPES) {
    const matches = artifacts.filter((artifact2) => artifact2.artifact_type === type);
    if (matches.length !== 1) findings.push({ severity: "error", code: "CANONICAL_SINGLETON", message: `Expected exactly one ${type}; found ${matches.length}` });
  }
  for (const artifact2 of artifacts) {
    for (const reference of [...artifact2.depends_on, ...artifact2.decisions, ...artifact2.writes_to]) {
      if (!byId.has(reference)) findings.push({ severity: "error", code: "REFERENCE_BROKEN", message: `${artifact2.id} references missing ${reference}`, file: artifact2.file });
    }
    for (const decision of artifact2.decisions) {
      const target = byId.get(decision);
      if (target && target.artifact_type !== "architectural_decision") findings.push({ severity: "error", code: "DECISION_TYPE_INVALID", message: `${artifact2.id} decision ${decision} is not an ADR`, file: artifact2.file });
    }
    if (artifact2.supersedes && !byId.has(artifact2.supersedes)) findings.push({ severity: "error", code: "SUPERSEDES_BROKEN", message: `${artifact2.id} supersedes missing ${artifact2.supersedes}`, file: artifact2.file });
    if (artifact2.supersedes === artifact2.id) findings.push({ severity: "error", code: "SUPERSEDES_SELF", message: `${artifact2.id} cannot supersede itself`, file: artifact2.file });
    if (artifact2.supersedes) {
      const previous = byId.get(artifact2.supersedes);
      if (previous && previous.artifact_type !== artifact2.artifact_type) findings.push({ severity: "error", code: "SUPERSEDES_TYPE_INVALID", message: `${artifact2.id} cannot supersede a different artifact type`, file: artifact2.file });
    }
    for (const reference of [...artifact2.depends_on, ...artifact2.writes_to]) {
      const upstream = byId.get(reference);
      if (upstream && (upstream.status === "retired" || upstream.status === "superseded") && (isLiveStatus(artifact2.status) || artifact2.status === "draft")) {
        findings.push({ severity: "error", code: "LIFECYCLE_DEPENDENCY", message: `${artifact2.id} is ${artifact2.status} but depends on ${upstream.status} ${reference}`, file: artifact2.file });
      }
    }
    if (config) {
      for (const mapping of artifact2.implementation) {
        const separator = mapping.indexOf(":");
        const sourceId = separator > 0 ? mapping.slice(0, separator) : "";
        const relative = separator > 0 ? mapping.slice(separator + 1) : "";
        const source = config.implementation_sources.find((item) => item.id === sourceId);
        if (!source || !relative) {
          findings.push({ severity: "error", code: "IMPLEMENTATION_MAPPING_INVALID", message: `${artifact2.id} implementation mapping must be <source-id>:<relative-path>: ${mapping}`, file: artifact2.file });
          continue;
        }
        const sourceRoot = path15.resolve(root2, source.path);
        const target = path15.resolve(sourceRoot, relative);
        if (!isWithin(sourceRoot, target)) findings.push({ severity: "error", code: "IMPLEMENTATION_MAPPING_ESCAPE", message: `${artifact2.id} implementation mapping escapes source ${sourceId}: ${mapping}`, file: artifact2.file });
        else if (!await pathExists(target)) findings.push({ severity: "error", code: "IMPLEMENTATION_TARGET_MISSING", message: `${artifact2.id} implementation target does not exist: ${mapping}`, file: artifact2.file });
        else {
          try {
            if (!await isRealPathWithin(sourceRoot, target)) findings.push({ severity: "error", code: "IMPLEMENTATION_MAPPING_SYMLINK_ESCAPE", message: `${artifact2.id} implementation mapping escapes source ${sourceId} through a symlink: ${mapping}`, file: artifact2.file });
          } catch {
            findings.push({ severity: "error", code: "IMPLEMENTATION_SOURCE_INVALID", message: `Cannot resolve implementation source ${sourceId}`, file: artifact2.file });
          }
        }
      }
    }
  }
  for (const entry of ruleCoverageEntries(artifacts)) {
    if (entry.covered) continue;
    findings.push({ severity: "warning", code: "RULE_UNVERIFIED", message: `${entry.rule} is declared but no unit, integration or system specification claims it`, file: entry.file });
  }
  for (const entry of specSizeEntries(artifacts)) {
    if (!entry.oversized) continue;
    findings.push({ severity: "warning", code: "SPEC_OVERSIZED", message: `${entry.id} holds ${entry.cases} test cases (threshold ${MAX_CASES_PER_SPEC}); split it ${entry.split_axis} before adding more`, file: entry.file });
  }
  for (const broken of brokenCaseReferences(artifacts)) {
    findings.push({ severity: "warning", code: "CASE_REFERENCE_BROKEN", message: `${broken.reference} names a case ${broken.specification} does not declare`, file: broken.file });
  }
  const graph = buildGraph(artifacts);
  const order = topologicalOrder(graph);
  if (order.cycles.length > 0) findings.push({ severity: "error", code: "DEPENDENCY_CYCLE", message: `Dependency cycle contains: ${order.cycles.join(", ")}` });
  for (const artifact2 of artifacts) {
    const seen = /* @__PURE__ */ new Set([artifact2.id]);
    let cursor = artifact2.supersedes;
    while (cursor) {
      if (seen.has(cursor)) {
        findings.push({ severity: "error", code: "SUPERSEDES_CYCLE", message: `Supersession cycle contains ${artifact2.id} and ${cursor}`, file: artifact2.file });
        break;
      }
      seen.add(cursor);
      cursor = byId.get(cursor)?.supersedes ?? null;
    }
  }
  try {
    const openapi = import_yaml4.default.parse(await readFile13(path15.join(root2, "03-design/interfaces/openapi.yaml"), "utf8"));
    if (openapi.openapi !== "3.1.0") findings.push({ severity: "error", code: "OPENAPI_VERSION", message: "openapi.yaml must use OpenAPI 3.1.0" });
  } catch (error) {
    findings.push({ severity: "error", code: "OPENAPI_INVALID", message: `Invalid openapi.yaml: ${String(error)}` });
  }
  try {
    const state = await loadCurrentState(root2);
    if (config && state.project_id !== config.project_id) findings.push({ severity: "error", code: "PROJECT_ID_MISMATCH", message: `State project_id ${state.project_id} does not match configuration ${config.project_id}` });
    for (const artifact2 of artifacts) {
      const registered = state.id_registry[artifact2.id];
      if (registered && registered !== artifact2.file) findings.push({ severity: "error", code: "ID_REUSED", message: `${artifact2.id} was first registered at ${registered}, not ${artifact2.file}`, file: artifact2.file });
    }
    for (const question of openQuestions(artifacts)) {
      const age = baselinesOpen(state.question_first_baseline?.[question.id], state.active_baseline);
      if (age === null || age < STALE_AFTER_BASELINES) continue;
      const blocks = question.affected ? ` It still blocks: ${question.affected}.` : "";
      findings.push({ severity: "warning", code: "QUESTION_STALE", message: `${question.id} has been open for ${age} baselines since ${state.question_first_baseline?.[question.id]}; close it with evidence, close it with a decision that makes it moot, or record why it stays open.${blocks}`, file: question.file });
    }
  } catch {
    findings.push({ severity: "error", code: "STATE_INVALID", message: `Missing or invalid ${projectPaths(root2).current}` });
  }
  const baselineFile = projectPaths(root2).baseline;
  if (await pathExists(baselineFile)) {
    try {
      await assertSafeManagedPath(root2, baselineFile);
      const baseline2 = await readJson(baselineFile);
      if (!isBaselineManifest(baseline2)) throw new Error("schema mismatch");
      const old = new Map(baseline2.artifacts.map((item) => [item.id, item]));
      for (const previous of old.values()) {
        if (!byId.has(previous.id)) findings.push({ severity: "error", code: "BASELINED_ARTIFACT_DELETED", message: `${previous.id} must be retained and marked deprecated, retired, or superseded instead of deleted`, file: previous.file });
      }
      for (const artifact2 of artifacts) {
        const previous = old.get(artifact2.id);
        if (previous && (previous.artifact_type !== artifact2.artifact_type || previous.created_by_change !== artifact2.created_by_change)) {
          findings.push({ severity: "error", code: "ARTIFACT_IDENTITY_CHANGED", message: `${artifact2.id} changed its permanent artifact type or creation identity`, file: artifact2.file });
        }
        const immutable = previous?.artifact_type === "original_idea" || previous?.artifact_type === "architectural_decision" && previous.adr_status === "accepted" || previous?.status === "retired" || previous?.status === "superseded";
        if (immutable && previous && previous.hash !== artifact2.hash) findings.push({ severity: "error", code: "IMMUTABLE_CHANGED", message: `${artifact2.id} is immutable after baselining; create a successor artifact instead`, file: artifact2.file });
      }
    } catch {
      findings.push({ severity: "error", code: "BASELINE_INVALID", message: "baseline-manifest.json is invalid" });
    }
  }
  try {
    findings.push(...await validateActiveArtifactContent(root2, artifacts));
  } catch (error) {
    findings.push({ severity: "error", code: "PATTERN_CATALOG_INVALID", message: String(error) });
  }
  findings.push(...await validateInternalRecords(root2, artifacts));
  return { valid: findings.every((item) => item.severity !== "error"), findings, artifact_count: artifacts.length };
}

// src/core/test-selection.ts
var testTypes2 = {
  unit: /* @__PURE__ */ new Set(["unit_test_backend", "unit_test_frontend", "unit_test_job"]),
  integration: /* @__PURE__ */ new Set(["integration_test"]),
  system: /* @__PURE__ */ new Set(["system_test"])
};
function selectTests(artifacts, graph, affected) {
  const affectedSet = new Set(affected);
  const affectedTypes = new Set(graph.nodes.filter((node) => affectedSet.has(node.id) && node.status !== "retired" && node.status !== "superseded").map((node) => node.type));
  const required = {
    unit: ["feature", "use_case", "screen", "component", "subsystem", "api_processing", "entity", "job", "access_control", "system_invariants", "error_catalog", "openapi_contract", "screen_transitions"].some((type) => affectedTypes.has(type)),
    integration: ["business_flow", "subsystem", "api_processing", "entity", "external_integration", "job", "event", "access_control", "quality_requirements", "system_invariants", "error_catalog", "openapi_contract", "physical_schema"].some((type) => affectedTypes.has(type)),
    system: ["feature", "use_case", "business_flow", "access_control", "quality_requirements", "system_invariants", "openapi_contract", "screen_transitions"].some((type) => affectedTypes.has(type))
  };
  const selected = { unit: [], integration: [], system: [] };
  for (const [level, types] of Object.entries(testTypes2)) {
    selected[level] = artifacts.filter((artifact2) => artifact2.status !== "retired" && artifact2.status !== "superseded" && types.has(artifact2.artifact_type) && artifact2.depends_on.some((id2) => affectedSet.has(id2))).map((artifact2) => artifact2.id).sort();
  }
  const missing = Object.keys(required).filter((level) => required[level] && selected[level].length === 0).map((level) => `No ${level.toUpperCase()} specification covers the affected artifacts.`);
  return { selected, required, missing };
}

