async function scanArtifacts(root2) {
  const files = await (0, import_fast_glob.default)(artifactGlobs, {
    cwd: root2,
    onlyFiles: true,
    ignore: ["**/.gitkeep"],
    dot: false,
    followSymbolicLinks: false
  });
