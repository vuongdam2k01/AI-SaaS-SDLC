// src/core/coverage-derivation.ts
function ids(body, pattern) {
  return [...new Set(body.match(pattern) ?? [])].sort();
}
function cell(values) {
  return values.length > 0 ? values.map((value) => `\`${value}\``).join(", ") : "\u2014";
}
function table(headers, rows) {
  const head = `| ${headers.join(" | ")} |`;
  const divider = `| ${headers.map(() => "---").join(" | ")} |`;
  const body = rows.length > 0 ? rows.map((row) => `| ${row.join(" | ")} |`).join("\n") : `| ${headers.map(() => "\u2014").join(" | ")} |`;
  return `${head}
${divider}
${body}
`;
}
function evidenceClaimCoverage(artifacts) {
  const ledger = artifacts.find((artifact2) => artifact2.artifact_type === "evidence_ledger");
  const evidenceIds = ids(ledger?.body ?? "", /\bEVD-[A-Z0-9-]+\b/g);
  const rows = evidenceIds.map((evidenceId) => {
    const consumers = artifacts.filter((artifact2) => artifact2.id !== ledger?.id && new RegExp(`\\b${evidenceId}\\b`).test(artifact2.body)).map((artifact2) => artifact2.id);
    return [`\`${evidenceId}\``, cell(consumers), consumers.length > 0 ? "consumed" : "unconsumed"];
  });
  return `# Evidence-to-Claim Coverage

This projection shows which canonical synthesis artifacts explicitly consume each evidence entry.

${table(["Evidence", "Referenced by", "Status"], rows)}`;
}
function acceptanceCoverage(artifacts) {
  const acceptanceIds = artifacts.filter((artifact2) => artifact2.artifact_type === "feature" && artifact2.status !== "retired" && artifact2.status !== "superseded").flatMap((artifact2) => ids(artifact2.body, /\bAC-[A-Z0-9-]+\b/g).map((id2) => ({ id: id2, feature: artifact2.id })));
  const rows = acceptanceIds.map(({ id: id2, feature }) => {
    const qualified = `${feature}#${id2}`;
    const consumers = artifacts.filter((artifact2) => artifact2.id !== feature && (artifact2.body.includes(qualified) || artifact2.depends_on.includes(feature) && new RegExp(`\\b${id2}\\b`).test(artifact2.body)));
    const behavior = consumers.filter((artifact2) => behaviorTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    const design = consumers.filter((artifact2) => designTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    const tests2 = consumers.filter((artifact2) => testTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    return [`\`${qualified}\``, `\`${feature}\``, cell(behavior), cell(design), cell(tests2), behavior.length > 0 && tests2.length > 0 ? "covered" : "gap"];
  });
  return `# Acceptance Coverage

Design is conditional; behavior and verification references are required for complete coverage.

${table(["Acceptance criterion", "Feature", "Behavior", "Design", "Tests", "Status"], rows)}`;
}
function ruleCoverage(artifacts) {
  const rows = ruleCoverageEntries(artifacts).map((entry) => [
    `\`${entry.rule}\``,
    `\`${entry.feature}\``,
    cell(entry.unit),
    cell(entry.integration),
    cell(entry.system),
    entry.covered ? "covered" : "unverified"
  ]);
  return `# Business Rule Coverage

Every business rule declared by a live feature must be claimed by at least one verification specification. The level is a derivation judgement; having a level at all is a contract.

${table(["Business rule", "Feature", "Unit", "Integration", "System", "Status"], rows)}`;
}
function ruleCoverageEntries(artifacts) {
  const features = artifacts.filter((artifact2) => artifact2.artifact_type === "feature" && artifact2.status !== "retired" && artifact2.status !== "superseded");
  return features.flatMap((feature) => ids(feature.body, /\bBR-[A-Z0-9-]+\b/g).map((rule) => {
    const qualified = `${feature.id}#${rule}`;
    const claimants = artifacts.filter((artifact2) => testTypes.has(artifact2.artifact_type) && (artifact2.body.includes(qualified) || artifact2.depends_on.includes(feature.id) && new RegExp(`\\b${rule}\\b`).test(artifact2.body)));
    const unit = claimants.filter((artifact2) => unitTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    const integration = claimants.filter((artifact2) => artifact2.artifact_type === "integration_test").map((artifact2) => artifact2.id);
    const system = claimants.filter((artifact2) => artifact2.artifact_type === "system_test").map((artifact2) => artifact2.id);
    return { rule: qualified, feature: feature.id, file: feature.file, unit, integration, system, covered: claimants.length > 0 };
  }));
}
