function nextBaselineId(current) {
  if (!current) return "BL-000";
  const number = Number(current.slice(3));
  if (!Number.isInteger(number)) throw new SdlcError(`Invalid active baseline ID: ${current}`);
  return formatId("BL", number + 1);
}
async function flowExecutions(root2, flowId) {
  const executionsDirectory = projectPaths(root2).executions;
  if (!await pathExists(executionsDirectory)) return [];
  await assertSafeManagedPath(root2, path17.join(executionsDirectory, ".managed-probe"));
  for (const entry of await readdir4(executionsDirectory, { withFileTypes: true })) if (entry.isSymbolicLink() && /^EXEC-.*\.json$/.test(entry.name)) throw new SdlcError(`Execution record cannot be a symlink: ${entry.name}`);
  const files = await (0, import_fast_glob8.default)("EXEC-*.json", { cwd: executionsDirectory, absolute: true, followSymbolicLinks: false });
  const records = [];
  for (const file of files) {
    await assertSafeManagedPath(root2, file);
    const record2 = await readJson(file);
    if (!isExecutionRecord(record2)) throw new SdlcError(`Invalid execution record schema: ${file}`);
    if (record2.flow_id === flowId) records.push(record2);
  }
  return records;
}
async function createBaselineUnlocked(root2) {
  const flow2 = await loadActiveFlow(root2);
  if (!flow2) throw new SdlcError("A baseline can only be created inside an active flow.");
  if (flow2.baseline_created) throw new SdlcError(`Flow ${flow2.id} already created baseline ${flow2.baseline_created}.`);
  const config = await loadConfig(root2);
  const artifacts = await scanArtifacts(root2);
  const validation = await validateProject(root2, artifacts);
  if (!validation.valid) throw new SdlcError(`Baseline blocked by validation errors:
${validation.findings.filter((item) => item.severity === "error").map((item) => `- ${item.code}: ${item.message}`).join("\n")}`);
  const previous = await loadBaseline(root2);
  const graph = buildGraph(artifacts);
  const impact = calculateImpact(artifacts, graph, previous);
  enforceFlowArtifactBoundaries(flow2, artifacts, previous, impact);
  if (flow2.type === "evolution" || flow2.type === "reconciliation") {
    const tests2 = selectTests(artifacts, graph, impact.affected);
    if (tests2.missing.length > 0) throw new SdlcError(`Baseline blocked by missing test specifications:
${tests2.missing.map((item) => `- ${item}`).join("\n")}`);
    const unfinished = artifacts.filter((artifact2) => artifact2.created_by_change === flow2.change_id && artifact2.status === "draft");
    if (unfinished.length > 0) throw new SdlcError(`Baseline blocked by draft artifacts created by ${flow2.change_id}: ${unfinished.map((item) => item.id).join(", ")}`);
    for (const feature of artifacts.filter((artifact2) => artifact2.artifact_type === "feature" && artifact2.status === "active")) {
      const closure = new Set(reverseClosure(graph, [feature.id]));
      const types = new Set(artifacts.filter((artifact2) => closure.has(artifact2.id) && artifact2.status === "active").map((artifact2) => artifact2.artifact_type));
      const coverage = [
        { types: ["use_case"], label: "UC" },
        { types: ["business_flow"], label: "FLOW" },
        { types: ["unit_test_backend", "unit_test_frontend", "unit_test_job"], label: "UT" },
        { types: ["integration_test"], label: "IT" },
        { types: ["system_test"], label: "ST" }
      ];
      const missingTypes = coverage.filter((item) => !item.types.some((candidate) => types.has(candidate))).map((item) => item.label);
      if (missingTypes.length > 0) throw new SdlcError(`${feature.id} lacks active downstream coverage: ${missingTypes.join(", ")}`);
      if (config.implementation_sources.length > 0) {
        const featureArtifacts = artifacts.filter((artifact2) => closure.has(artifact2.id) && !/(?:^|_)test(?:_|$)/.test(artifact2.artifact_type));
        if (!featureArtifacts.some((artifact2) => artifact2.implementation.length > 0)) throw new SdlcError(`${feature.id} has no implementation mapping despite configured implementation sources.`);
        for (const [label, accepted] of [["UT", ["unit_test_backend", "unit_test_frontend", "unit_test_job"]], ["IT", ["integration_test"]], ["ST", ["system_test"]]]) {
          const covered = artifacts.filter((artifact2) => closure.has(artifact2.id) && accepted.some((type) => type === artifact2.artifact_type) && artifact2.status === "active");
          if (!covered.some((artifact2) => artifact2.implementation.length > 0)) throw new SdlcError(`${feature.id} has no ${label} implementation mapping despite configured implementation sources.`);
        }
      }
    }
  }
  await refreshProject(root2, false);
  const state = await loadCurrentState(root2);
  if (flow2.type === "genesis" || flow2.type === "reassessment") state.evidence_revision += 1;
  let id2 = state.active_baseline;
  if (flow2.type !== "reassessment") id2 = nextBaselineId(state.active_baseline);
  if (!id2) throw new SdlcError("Evidence reassessment requires an existing product baseline.");
  const executions = await flowExecutions(root2, flow2.id);
  const verification = Object.fromEntries(["unit", "integration", "system"].map((level) => {
    const definitions = config.verification[level];
    const records = executions.filter((record2) => record2.level === level);
    if (definitions.length === 0) return [level, "not-configured"];
    const latest = definitions.map((definition) => latestExecution(records.filter((record2) => record2.command_id === definition.id && record2.command === definition.command && record2.cwd === definition.cwd)));
    if (latest.some((record2) => !record2)) return [level, "not-run"];
    return [level, latest.every((record2) => record2?.exit_code === 0) ? "passed" : "failed"];
  }));
  if (Object.values(verification).includes("failed")) throw new SdlcError("Baseline blocked because a configured verification command failed.");
  if ((flow2.type === "evolution" || flow2.type === "reconciliation") && Object.values(verification).includes("not-run")) throw new SdlcError("Baseline blocked because configured verification commands were not run in the active flow.");
  if (flow2.type === "reconciliation") {
    const repairedCanonical = artifacts.some((artifact2) => impact.direct.includes(artifact2.id) && artifact2.artifact_type !== "issue" && artifact2.artifact_type !== "test_result" && artifact2.id !== "SDLC-CONFIG");
    const successfulExecution = executions.some((record2) => record2.exit_code === 0);
    if (!repairedCanonical && !successfulExecution) throw new SdlcError("Reconciliation requires a repaired canonical artifact or a successful execution proving a code/configuration-only repair.");
  }
  if ((flow2.type === "evolution" || flow2.type === "reconciliation") && config.implementation_sources.length > 0) {
    const required = selectTests(artifacts, graph, impact.affected).required;
    const missingExecutionLevel = Object.keys(required).filter((level) => required[level] && verification[level] === "not-configured");
    if (missingExecutionLevel.length > 0) throw new SdlcError(`Configured implementation sources require verification commands for: ${missingExecutionLevel.join(", ")}`);
  }
  const manifest = {
    schema_version: 1,
    id: id2,
    evidence_revision: `EVR-${String(state.evidence_revision).padStart(3, "0")}`,
    created_at: (/* @__PURE__ */ new Date()).toISOString(),
    git_commit: gitCommit(root2),
    flow_type: flow2.type,
    flow_id: flow2.id,
    artifacts: artifacts.map((artifact2) => ({
      id: artifact2.id,
      title: artifact2.title,
      file: artifact2.file,
      hash: artifact2.hash,
      status: artifact2.status,
      artifact_type: artifact2.artifact_type,
      created_by_change: artifact2.created_by_change,
      depends_on: artifact2.depends_on,
      decisions: artifact2.decisions,
      supersedes: artifact2.supersedes,
      writes_to: artifact2.writes_to,
      implementation: artifact2.implementation,
      ...artifact2.adr_status ? { adr_status: artifact2.adr_status } : {}
    })).sort((a, b) => a.id.localeCompare(b.id)),
    executions: executions.map((record2) => record2.id).sort(),
    verification
  };
  for (const artifact2 of artifacts) state.id_registry[artifact2.id] ??= artifact2.file;
  const open2 = openQuestions(artifacts);
  const ages = {};
  for (const question of open2) ages[question.id] = state.question_first_baseline?.[question.id] ?? id2;
  state.question_first_baseline = ages;
  state.active_baseline = id2;
  await saveCurrentState(root2, state);
  await prepareSafeManagedPath(root2, projectPaths(root2).baseline);
  await writeJsonAtomic(projectPaths(root2).baseline, manifest);
  flow2.baseline_created = id2;
  flow2.baseline_implementation_snapshot_hash = await implementationSnapshotHash(root2);
  await prepareSafeManagedPath(root2, projectPaths(root2).activeFlow);
  await writeJsonAtomic(projectPaths(root2).activeFlow, flow2);
  if (flow2.change_id) {
    const file = path17.join(projectPaths(root2).changes, `${flow2.change_id}.json`);
    await assertSafeManagedPath(root2, file);
    const change = await readJson(file);
    if (!isChangeRecord(change)) throw new SdlcError(`Invalid change record schema: ${file}`);
    await prepareSafeManagedPath(root2, file);
    await writeJsonAtomic(file, { ...change, status: "baselined", successor_baseline: id2, impact });
  }
  await refreshProject(root2, false);
  return manifest;
}
async function createBaseline(root2) {
  return withProjectLock(root2, () => createBaselineUnlocked(root2));
}
async function syncRepresentationChangesUnlocked(root2) {
  const flow2 = await loadActiveFlow(root2);
  if (flow2) return [];
  const baseline2 = await loadBaseline(root2);
  if (!baseline2) return [];
  const artifacts = await scanArtifacts(root2);
  const validation = await validateProject(root2, artifacts);
  const errors = validation.findings.filter((item) => item.severity === "error");
  if (errors.length > 0) throw new SdlcError(`Editorial synchronization requires a structurally valid repository:
${errors.map((item) => `- ${item.code}: ${item.message}`).join("\n")}`);
  const current = new Map(artifacts.map((artifact2) => [artifact2.id, artifact2]));
  const synchronized = [];
  for (const entry of baseline2.artifacts) {
    const artifact2 = current.get(entry.id);
    const relationsUnchanged = artifact2 && artifact2.artifact_type === entry.artifact_type && artifact2.title === entry.title && artifact2.created_by_change === entry.created_by_change && artifact2.status === entry.status && artifact2.supersedes === entry.supersedes && JSON.stringify(artifact2.depends_on) === JSON.stringify(entry.depends_on) && JSON.stringify(artifact2.decisions) === JSON.stringify(entry.decisions) && JSON.stringify(artifact2.writes_to) === JSON.stringify(entry.writes_to) && JSON.stringify(artifact2.implementation) === JSON.stringify(entry.implementation) && artifact2.adr_status === entry.adr_status;
    if (!artifact2 || artifact2.file !== entry.file || artifact2.hash === entry.hash || !relationsUnchanged) continue;
    const immutable = entry.artifact_type === "original_idea" || entry.artifact_type === "evidence_ledger" || entry.artifact_type === "test_result" || entry.artifact_type === "architectural_decision" && entry.adr_status === "accepted" || entry.status === "retired" || entry.status === "superseded" || ["engine_configuration", "openapi_contract", "physical_schema", "screen_transitions"].includes(entry.artifact_type);
    if (immutable) continue;
    entry.hash = artifact2.hash;
    synchronized.push(entry.id);
  }
  if (synchronized.length > 0) {
    await prepareSafeManagedPath(root2, projectPaths(root2).baseline);
    await writeJsonAtomic(projectPaths(root2).baseline, baseline2);
  }
  return synchronized.sort();
}
async function syncRepresentationChanges(root2) {
  return withProjectLock(root2, () => syncRepresentationChangesUnlocked(root2));
}

// src/cli/main.ts
init_errors();
init_project_lock();

// src/core/runtime-root.ts
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
function resolveRuntimeRoot(moduleUrl) {
  const configured = process.env.CODEX_PLUGIN_ROOT ?? process.env.CLAUDE_PLUGIN_ROOT;
  return configured ? resolve(configured) : resolve(dirname(fileURLToPath(moduleUrl)), "..");
}

// src/core/artifact-instantiation.ts
import { mkdir as mkdir6, readFile as readFile14, writeFile as writeFile6 } from "node:fs/promises";
import path18 from "node:path";
init_errors();
init_paths();
init_state();
init_project_lock();
function tokenValues(id2, title, createdBy) {
  const parts = id2.split("-");
  const number = parts.at(-1) ?? "";
  const area = parts.slice(parts[0] === "UT" ? 2 : 1, -1).join("-") || number;
  return {
    ID: id2,
    TITLE: title,
    CREATED_BY_CHANGE: createdBy,
    CHG_ID: createdBy,
    FLOW_OR_CHANGE_ID: createdBy,
    AREA: area,
    NNN: number,
    SEGMENT: area,
    ROLE: area,
    SLUG: area,
    API_ID: area,
    JOB_ID: area,
    TARGET_ID: "",
    FEATURE_OR_FLOW_ID: "",
    TRIGGER_ID: ""
  };
}
function render(template, values) {
  let output = template.replace(/\r\n/g, "\n").replace(/^title:\s*\{\{TITLE\}\}\s*$/m, `title: ${JSON.stringify(values.TITLE)}`);
  for (const [key, value] of Object.entries(values)) output = output.replaceAll(`{{${key}}}`, value);
  const frontmatterEnd = output.indexOf("\n---\n", 4);
  if (frontmatterEnd > 0) {
    const head = output.slice(0, frontmatterEnd).replace(/\[(?:\s*,?\s*\{\{[^}]+\}\}\s*,?)*\]/g, "[]").replace(/:\s*\{\{[^}]+\}\}\s*$/gm, ":");
    output = head + output.slice(frontmatterEnd);
  }
  const unresolved = output.match(/\{\{[A-Z0-9_]+\}\}/g);
  if (unresolved) throw new SdlcError(`Pattern contains unsupported template tokens: ${[...new Set(unresolved)].join(", ")}`);
  return output.replace(/\s+$/, "") + "\n";
}
function resolveTarget(root2, pattern, id2) {
  const relative = pattern.target.replaceAll("{{ID}}", id2).replaceAll("{id}", id2);
  if (relative.includes("{{") || path18.isAbsolute(relative)) throw new SdlcError(`Pattern target is not instantiable: ${pattern.target}`);
  const target = path18.resolve(root2, relative);
  if (!isWithin(root2, target)) throw new SdlcError(`Artifact target escapes project root: ${relative}`);
  const normalized = path18.relative(root2, target).replaceAll("\\", "/");
  const location = SCALABLE_LOCATIONS[pattern.artifact_type];
  if (!location || !location.test(normalized) || path18.basename(normalized, ".md") !== id2) throw new SdlcError(`Catalog target violates the approved location for ${pattern.artifact_type}: ${normalized}`);
  return target;
}
async function createUnlocked(root2, catalog, artifactType, id2, title) {
  const flow2 = await loadActiveFlow(root2);
  if (!flow2) throw new SdlcError("Artifact creation requires an active semantic flow.");
  const pattern = catalog.patterns.find((item) => item.artifact_type === artifactType);
  if (!pattern) throw new SdlcError(`Unknown scalable artifact type: ${artifactType}`);
  if (artifactType === "test_result") throw new SdlcError("Test results are execution-backed and cannot be created from a pattern.");
  assertFlowAllowsArtifactType(flow2.type, artifactType);
  if (!new RegExp(`^(?:${pattern.id_pattern})$`).test(id2)) throw new SdlcError(`${id2} does not match ${artifactType} ID contract ${pattern.id_pattern}.`);
  if (title.trim() === "" || /[\r\n\0]/.test(title) || title.includes("{{")) throw new SdlcError("Artifact title must be one non-empty line without template tokens.");
  const target = resolveTarget(root2, pattern, id2);
  await prepareSafeManagedPath(root2, target);
  if (await pathExists(target)) throw new SdlcError(`Artifact already exists: ${path18.relative(root2, target)}`);
  const source = path18.resolve(catalog.root, pattern.template);
  if (!isWithin(catalog.root, source)) throw new SdlcError(`Pattern source escapes catalog root: ${pattern.template}`);
  const createdBy = flow2.change_id ?? flow2.id;
  const content = render(await readFile14(source, "utf8"), tokenValues(id2, title.trim(), createdBy));
  await mkdir6(path18.dirname(target), { recursive: true });
  await writeFile6(target, content, { encoding: "utf8", flag: "wx" });
  return { id: id2, artifact_type: artifactType, file: path18.relative(root2, target).replaceAll("\\", "/") };
}
async function createArtifactFromPattern(root2, catalog, artifactType, id2, title) {
  return withProjectLock(root2, async () => {
    const fresh = await loadPatternCatalog(catalog.root, isWithin(root2, catalog.root) ? root2 : void 0);
    return createUnlocked(root2, fresh, artifactType, id2, title);
  });
}

// src/cli/main.ts
var program2 = new Command();
var root = process.cwd();
var runtimeRoot = resolveRuntimeRoot(import.meta.url);
if (Number(process.versions.node.split(".")[0]) < 22) {
  throw new SdlcError(`Node.js 22 or newer is required; found ${process.versions.node}.`);
}
function print(value, json = false) {
  if (json || typeof value !== "string") console.log(JSON.stringify(value, null, 2));
  else console.log(value);
}
program2.name("ai-saas-sdlc").description("Deterministic engine for AI SaaS SDLC documentation flows.").version("1.3.2");
program2.command("init").description("Initialize a centralized documentation repository.").option("--project-id <id>", "Stable project identifier").option("--idea <text>", "Raw idea preserved verbatim", "").action(async (options) => {
  const projectId = options.projectId ?? root.split(/[\\/]/).at(-1)?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") ?? "saas-project";
  await withProjectLock(root, async () => {
    await initializeProject(
      root,
      resolve2(runtimeRoot, "resources", "project-template"),
      projectId,
      options.idea,
      resolve2(runtimeRoot, "resources", "artifact-patterns")
    );
    await refreshProject(root, false);
    await recordEnginePointer(root, runtimeRoot, program2.version() ?? "0.0.0");
    await ensureEnginePointerIgnored(root);
  });
  print(`Initialized AI SaaS SDLC documentation repository: ${projectId}`);
});
var patterns = program2.command("patterns").description("Inspect the pinned scalable artifact pattern catalog.");
patterns.command("list").option("--json", "Emit JSON").action(async (options) => {
  const catalog = await resolveCatalog(root, runtimeRoot);
  const entries = catalog.patterns.map((pattern) => ({
    artifact_type: pattern.artifact_type,
    id_pattern: pattern.id_pattern,
    target: pattern.target,
    template: pattern.template
  }));
  print(options.json ? { version: catalog.version, patterns: entries } : entries.map((entry) => `${entry.artifact_type}	${entry.id_pattern}	${entry.target}`).join("\n"), Boolean(options.json));
});
var artifact = program2.command("artifact").description("Instantiate scalable artifacts from the pinned pattern catalog.");
artifact.command("create").requiredOption("--type <type>", "Catalog artifact_type").requiredOption("--id <id>", "Permanent artifact ID").requiredOption("--title <title>", "Human-readable title").option("--json", "Emit JSON").action(async (options) => {
  const result = await createArtifactFromPattern(root, await resolveCatalog(root, runtimeRoot), options.type, options.id, options.title);
  print(options.json ? result : `Created ${result.id} at ${result.file}`, Boolean(options.json));
});
program2.command("state").description("Show current baseline and active flow.").option("--json", "Emit JSON").action(async (options) => {
  const current = await loadCurrentState(root);
  const flow2 = await loadActiveFlow(root);
  const questions = openQuestions(await scanArtifacts(root)).map((question) => ({
    id: question.id,
    first_baseline: current.question_first_baseline?.[question.id] ?? null,
    baselines_open: baselinesOpen(current.question_first_baseline?.[question.id], current.active_baseline),
    stale: (baselinesOpen(current.question_first_baseline?.[question.id], current.active_baseline) ?? 0) >= STALE_AFTER_BASELINES
  })).sort((a, b) => (b.baselines_open ?? -1) - (a.baselines_open ?? -1) || a.id.localeCompare(b.id));
  print({ current, active_flow: flow2, open_questions: questions }, Boolean(options.json));
});
var flow = program2.command("flow").description("Manage one of the four temporal flows.");
flow.command("start").requiredOption("--type <type>", "genesis|reassessment|evolution|reconciliation").option("--input <text>", "Raw flow trigger", "").option("--until <stage>", "Stop this turn at behavior|design|tests|implementation|baseline").option("--json", "Emit JSON").action(async (options) => {
  if (options.until !== void 0 && !FLOW_STAGES.includes(options.until)) {
    throw new SdlcError(`Unsupported flow stage: ${options.until}. Expected ${FLOW_STAGES.join("|")}.`);
  }
  print(await startFlow(root, options.type, options.input, options.until), Boolean(options.json));
});
flow.command("checkpoint").description("Record the checkpoint an open flow has reached, and optionally retarget where it stops.").requiredOption("--stage <stage>", "behavior|design|tests|implementation|baseline").option("--until <stage>", "Retarget where this turn stops").option("--json", "Emit JSON").action(async (options) => {
  print(await checkpointFlow(root, options.stage, options.until), Boolean(options.json));
});
flow.command("next").description("Report the open flow's progress and the exact command to run next.").option("--json", "Emit JSON").action(async (options) => print(await flowGuidance(root), Boolean(options.json)));
flow.command("close").option("--json", "Emit JSON").action(async (options) => print(await closeFlow(root), Boolean(options.json)));
program2.command("impact").description("Compute direct changes and reverse dependency closure.").option("--json", "Emit JSON").action(async (options) => print((await projectSnapshot(root)).impact, Boolean(options.json)));
program2.command("validate").description("Validate schemas, IDs, lifecycle, references, immutable artifacts and results.").option("--active", "Validate during the active flow").option("--all", "Validate the full repository").option("--json", "Emit JSON").action(async (options) => {
  const artifacts = await scanArtifacts(root);
  const report = await validateProject(root, artifacts);
  const drift = await refreshProject(root, true);
  if (drift.length > 0) {
    report.findings.push({ severity: "error", code: "GENERATED_DRIFT", message: `Generated projections are out of sync: ${drift.join(", ")}` });
    report.valid = false;
  }
  print(report, Boolean(options.json));
  if (!report.valid) process.exitCode = 1;
});
var tests = program2.command("tests").description("Derive verification requirements from impact.");
tests.command("select").option("--json", "Emit JSON").action(async (options) => {
  const snapshot = await projectSnapshot(root);
  print(selectTests(snapshot.artifacts, buildGraph(snapshot.artifacts), snapshot.impact.affected), Boolean(options.json));
});
program2.command("verify").description("Execute only verification commands declared in sdlc.config.yaml.").addOption(new Option("--unit", "Run UT commands")).addOption(new Option("--integration", "Run IT commands")).addOption(new Option("--system", "Run ST commands")).addOption(new Option("--all", "Run UT, IT and ST commands")).requiredOption("--execute", "Confirm execution of declared commands").option("--json", "Emit JSON").action(async (options) => {
  const levels = options.all || !options.unit && !options.integration && !options.system ? ["unit", "integration", "system"] : [options.unit && "unit", options.integration && "integration", options.system && "system"].filter(Boolean);
  const records = await executeVerification(root, await loadConfig(root), [...levels]);
  print(records, Boolean(options.json));
  if (records.some((record2) => record2.exit_code !== 0)) process.exitCode = 1;
});
var baseline = program2.command("baseline").description("Manage verified semantic baselines.");
baseline.command("create").option("--json", "Emit JSON").action(async (options) => print(await createBaseline(root), Boolean(options.json)));
program2.command("refresh").description("Regenerate deterministic projections.").option("--check", "Report drift without writing").option("--editorial", "Explicitly accept body-only editorial changes without a product flow").option("--json", "Emit JSON").action(async (options) => {
  if (options.check && options.editorial) throw new SdlcError("--check and --editorial cannot be combined.");
  if (options.editorial) await syncRepresentationChanges(root);
  const drift = await refreshProject(root, Boolean(options.check));
  if (!options.check) await recordEnginePointer(root, runtimeRoot, program2.version() ?? "0.0.0");
  print({ synchronized: drift.length === 0, drift }, Boolean(options.json));
  if (options.check && drift.length > 0) process.exitCode = 1;
});
program2.command("migrate").description("Check or apply documentation schema migrations.").option("--check", "Check only").option("--json", "Emit JSON").action(async (options) => {
  const config = await loadConfig(root);
  const state = await loadCurrentState(root);
  const result = { current_schema: 1, migration_required: config.schema_version !== 1 || state.schema_version !== 1 };
  print(result, Boolean(options.json));
  if (result.migration_required) process.exitCode = 1;
});
program2.parseAsync().catch((error) => {
  const message = error instanceof Error ? error.message : String(error);
  console.error(message);
  process.exitCode = error instanceof SdlcError ? error.exitCode : 1;
});
