import { lstat as lstat3, mkdir as mkdir4, readFile as readFile7, realpath as realpath3, writeFile as writeFile3 } from "node:fs/promises";
import path8 from "node:path";
async function assertNoSymlinkAncestor(root2, target) {
  let current = path8.dirname(target);
  const boundary = path8.resolve(root2);
  while (isWithin(boundary, current) && path8.resolve(current) !== boundary) {
    try {
      const info = await lstat3(current);
      if (info.isSymbolicLink()) throw new SdlcError(`Initialization refuses symlinked destination directories: ${current}`);
      if (!info.isDirectory()) throw new SdlcError(`Initialization destination ancestor is not a directory: ${current}`);
    } catch (error) {
      if (error instanceof SdlcError) throw error;
      if (error.code !== "ENOENT") throw error;
    }
    current = path8.dirname(current);
  }
}
async function assertSafeSource(sourceRoot, source) {
  if (!isWithin(sourceRoot, source)) throw new SdlcError(`Initialization source escapes its root: ${source}`);
  const info = await lstat3(source);
  if (info.isSymbolicLink() || !info.isFile()) throw new SdlcError(`Initialization source must be a regular file: ${source}`);
  const [realRoot, realSource] = await Promise.all([realpath3(sourceRoot), realpath3(source)]);
  if (!isWithin(realRoot, realSource)) throw new SdlcError(`Initialization source resolves outside its root: ${source}`);
}
async function copyPlan(root2, templateRoot, patternRoot) {
  if (!await pathExists(path8.join(patternRoot, "catalog.yaml")) && !await pathExists(path8.join(patternRoot, "catalog.yml"))) {
    throw new SdlcError(`Pattern catalog is missing from ${patternRoot}.`);
  }
  const templateFiles = await (0, import_fast_glob5.default)("**/*", { cwd: templateRoot, onlyFiles: true, dot: true, followSymbolicLinks: false });
  const patternFiles = await (0, import_fast_glob5.default)("**/*", { cwd: patternRoot, onlyFiles: true, dot: true, followSymbolicLinks: false });
  const plan = [
    ...templateFiles.map((relative) => ({ source: path8.join(templateRoot, relative), target: path8.join(root2, relative), relative, substitute: true })),
    ...patternFiles.map((relative) => ({ source: path8.join(patternRoot, relative), target: path8.join(root2, "00-system", "patterns", relative), relative: `00-system/patterns/${relative.replaceAll("\\", "/")}`, substitute: false }))
  ];
  const targets = plan.map((item) => path8.resolve(item.target));
  if (new Set(targets).size !== targets.length) throw new SdlcError("Project skeleton and pattern snapshot define the same destination path.");
  for (const item of plan) await assertSafeSource(item.substitute ? templateRoot : patternRoot, item.source);
  return plan;
}
async function initializeProjectUnlocked(root2, templateRoot, patternRoot, projectId, idea) {
  if (!/^[a-z0-9][a-z0-9-]*$/.test(projectId)) throw new SdlcError("project_id must use lowercase letters, numbers, and hyphens.");
  if (await pathExists(projectPaths(root2).config)) throw new SdlcError("Repository is already initialized.");
  const plan = await copyPlan(root2, templateRoot, patternRoot);
  const conflicts = [];
  for (const item of plan) {
    if (!isWithin(root2, item.target)) throw new SdlcError(`Initialization path escapes project root: ${item.relative}`);
    await assertNoSymlinkAncestor(root2, item.target);
    if (await pathExists(item.target)) conflicts.push(item.relative);
  }
  const snapshotFile = path8.join(root2, "00-system", "patterns", "snapshot.json");
  await assertNoSymlinkAncestor(root2, snapshotFile);
  if (await pathExists(snapshotFile)) conflicts.push("00-system/patterns/snapshot.json");
  if (conflicts.length > 0) throw new SdlcError(`Initialization would overwrite existing files: ${conflicts.join(", ")}`);
  for (const item of plan.sort((a, b) => a.relative.localeCompare(b.relative))) {
    await mkdir4(path8.dirname(item.target), { recursive: true });
    const sourceContent = await readFile7(item.source, "utf8");
    const content = item.substitute ? sourceContent.replaceAll("{{PROJECT_ID}}", projectId).replaceAll("{{RAW_IDEA}}", idea === "" ? "Not provided. Invoke /ai-saas-sdlc:genesis with the raw idea." : idea) : sourceContent;
    await writeFile3(item.target, content, { encoding: "utf8", flag: "wx" });
  }
  const pinnedRoot = path8.join(root2, "00-system", "patterns");
  const pinnedFiles = await (0, import_fast_glob5.default)("**/*", { cwd: pinnedRoot, onlyFiles: true, dot: true, followSymbolicLinks: false });
  const patternHashes = [];
  for (const relative of pinnedFiles.sort()) {
    const content = await readFile7(path8.join(pinnedRoot, relative), "utf8");
    patternHashes.push(`00-system/patterns/${relative.replaceAll("\\", "/")}:${sha256(content)}`);
  }
  await writeFile3(snapshotFile, stableJson({ schema_version: 1, catalog_hash: sha256(patternHashes.join("\n")), files: patternHashes.length }), { encoding: "utf8", flag: "wx" });
  const state = {
    schema_version: 1,
    project_id: projectId,
    active_baseline: null,
    evidence_revision: 0,
    next_change: 1,
    next_flow: 1,
    next_execution: 1,
    id_registry: {}
  };
  await saveCurrentState(root2, state);
  const paths = projectPaths(root2);
  await Promise.all([
    mkdir4(paths.changes, { recursive: true }),
    mkdir4(paths.executions, { recursive: true }),
    mkdir4(paths.cache, { recursive: true })
  ]);
}
async function initializeProject(root2, templateRoot, projectId, idea, patternRoot = path8.resolve(templateRoot, "..", "artifact-patterns")) {
  return withProjectLock(root2, () => initializeProjectUnlocked(root2, templateRoot, patternRoot, projectId, idea));
}

