// src/core/execution-selection.ts
function latestExecution(records) {
  return records.reduce((latest, record2) => {
    const sequence = Number(record2.id.slice("EXEC-".length));
    const latestSequence = latest ? Number(latest.id.slice("EXEC-".length)) : -1;
    return sequence > latestSequence ? record2 : latest;
  }, void 0);
}
function samePlatformDeclaration(a, b2) {
  const left = [...a ?? []].sort();
  const right = [...b2 ?? []].sort();
  return left.length === right.length && left.every((value, index) => value === right[index]);
}
function matchesDefinitionEvidence(record2, definition) {
  return record2.command_id === definition.id && record2.command === definition.command && record2.cwd === definition.cwd && samePlatformDeclaration(record2.platforms, definition.platforms);
}
