var SOURCE_GLOB = "**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,py,go,rb,rs,java,kt,kts,php,cs,swift,sh,bash}";
var SCAN_EXCLUSIONS = [
  "**/node_modules/**",
