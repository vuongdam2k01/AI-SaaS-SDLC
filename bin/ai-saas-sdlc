  if (await pathExists(target)) {
    const existing = await readFile10(target, "utf8").catch(() => "");
    if (existing === serialized) return;
  }
  await mkdir5(path14.dirname(target), { recursive: true });
  await writeFile5(target, serialized, "utf8");
}
async function ensureIgnoredEntry(root2, entry) {
  const target = path14.join(root2, ".gitignore");
  const existing = await pathExists(target) ? await readFile10(target, "utf8").catch(() => "") : "";
  if (existing.split(/\r?\n/).some((line) => line.trim() === entry)) return;
  const prefix = existing === "" || existing.endsWith("\n") ? existing : `${existing}
`;
  await writeFile5(target, `${prefix}${entry}
`, "utf8");
}
