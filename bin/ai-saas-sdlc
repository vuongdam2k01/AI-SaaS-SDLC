// src/core/baseline-flow-rules.ts
init_errors();
var genesisFoundations = ["idea_definition", "evidence_ledger", "market_landscape", "customer_and_problem", "competitive_and_commercial", "feasibility_and_risk", "opportunity_definition", "product_requirements", "access_control", "quality_requirements", "system_invariants"];
var scalableTypes = /* @__PURE__ */ new Set(["feature", "use_case", "business_flow", "screen", "component", "subsystem", "api_processing", "entity", "external_integration", "job", "event", "unit_test_backend", "unit_test_frontend", "unit_test_job", "integration_test", "system_test", "test_result", "issue", "architectural_decision"]);
var reassessmentTypes = /* @__PURE__ */ new Set(["evidence_ledger", "idea_definition", "market_landscape", "customer_and_problem", "competitive_and_commercial", "feasibility_and_risk", "opportunity_definition", "ideal_customer_profile", "persona", "problem", "competitor", "question_ledger", "issue"]);
var genesisCreatable = /* @__PURE__ */ new Set(["ideal_customer_profile", "persona", "problem", "competitor"]);
var reassessmentCreatable = /* @__PURE__ */ new Set([...genesisCreatable, "issue"]);
var semanticCreatable = new Set([...scalableTypes].filter((type) => !["ideal_customer_profile", "persona", "problem", "competitor", "test_result"].includes(type)));
function assertFlowAllowsArtifactType(flowType, artifactType) {
  const allowed = flowType === "genesis" ? genesisCreatable : flowType === "reassessment" ? reassessmentCreatable : semanticCreatable;
  if (!allowed.has(artifactType)) throw new SdlcError(`${artifactType} cannot be created during ${flowType}.`);
}
function enforceFlowArtifactBoundaries(flow2, artifacts, previous, impact) {
  const previousIds = new Set(previous?.artifacts.map((artifact2) => artifact2.id) ?? []);
  const currentById = new Map(artifacts.map((artifact2) => [artifact2.id, artifact2.artifact_type]));
  const previousById = new Map(previous?.artifacts.map((artifact2) => [artifact2.id, artifact2.artifact_type]) ?? []);
  const directTypes = new Map(impact.direct.map((id2) => [id2, currentById.get(id2) ?? previousById.get(id2) ?? "unknown"]));
  const created = artifacts.filter((artifact2) => !previousIds.has(artifact2.id) && artifact2.id !== "SDLC-CONFIG" && !["openapi_contract", "physical_schema", "screen_transitions"].includes(artifact2.artifact_type));
  const expectedCreator = flow2.type === "genesis" ? /* @__PURE__ */ new Set(["GENESIS", flow2.id]) : /* @__PURE__ */ new Set([flow2.change_id ?? flow2.id]);
  const wronglyAttributed = created.filter((artifact2) => !expectedCreator.has(artifact2.created_by_change));
  if (wronglyAttributed.length > 0) throw new SdlcError(`New artifacts must identify the active flow/change as created_by_change: ${wronglyAttributed.map((artifact2) => artifact2.id).join(", ")}`);
  if (flow2.type === "genesis") {
    const incomplete = genesisFoundations.flatMap((type) => {
      const artifact2 = artifacts.find((candidate) => candidate.artifact_type === type);
      return !artifact2 || artifact2.status !== "active" ? [artifact2?.id ?? type] : [];
    });
    if (incomplete.length > 0) throw new SdlcError(`Genesis baseline requires active discovery and product foundations: ${incomplete.join(", ")}`);
    const ledger = artifacts.find((artifact2) => artifact2.artifact_type === "evidence_ledger");
    if (!ledger || !/^## EVD-[A-Z0-9-]+/m.test(ledger.body) || !/^- URL:\s*https?:\/\//m.test(ledger.body)) throw new SdlcError("Genesis baseline requires at least one attributable EVD entry with an inspected public URL.");
    const original = artifacts.find((artifact2) => artifact2.artifact_type === "original_idea");
    if (!original || /Not provided\. Invoke/.test(original.body)) throw new SdlcError("Genesis baseline requires the raw idea to be captured during initialization.");
    const premature = artifacts.filter((artifact2) => scalableTypes.has(artifact2.artifact_type) && !genesisCreatable.has(artifact2.artifact_type));
    if (premature.length > 0) throw new SdlcError(`Genesis creates discovery and product foundations only. Move scalable behavior/design/test/control artifacts into Product Evolution: ${premature.map((item) => item.id).join(", ")}`);
  }
  if (flow2.type === "reassessment") {
    if (![...directTypes.values()].includes("evidence_ledger")) throw new SdlcError("Evidence Reassessment must add or change attributable evidence.");
    const forbidden = [...directTypes].filter(([, type]) => !reassessmentTypes.has(type)).map(([id2]) => id2);
    if (forbidden.length > 0) throw new SdlcError(`Evidence Reassessment cannot mutate product, design, verification, or engine contracts: ${forbidden.join(", ")}. Open an issue and run Product Evolution instead.`);
  }
  const semantic = flow2.type === "evolution" || flow2.type === "reconciliation";
  if (semantic && [...directTypes.values()].includes("evidence_ledger")) throw new SdlcError("Evidence changes require Evidence Reassessment so EVR advances before product repair or evolution.");
  if (semantic && impact.direct.length === 0) throw new SdlcError(`${flow2.type} cannot create a baseline without a semantic artifact change.`);
}

