var READ_FORMS = [
  /\bprocess\.env\.([A-Z][A-Z0-9_]*)\b/g,
  /\bprocess\.env\[\s*["'`]([A-Z][A-Z0-9_]*)["'`]\s*\]/g,
  /\bimport\.meta\.env\.([A-Z][A-Z0-9_]*)\b/g,
