// src/core/result-artifact.ts
var NOT_REPORTED = "not reported by configured command";
function tableCell(value) {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("|", "&#124;").replace(/\r?\n/g, "&#10;");
}
function duration(record2) {
  const milliseconds = Date.parse(record2.ended_at) - Date.parse(record2.started_at);
  return Number.isFinite(milliseconds) && milliseconds >= 0 ? `${milliseconds} ms` : "not available: invalid execution timestamps";
}
function renderResultArtifact(record2, change) {
  const outcome = record2.exit_code === 0 ? "passed" : "failed";
  const recordFile = record2.output_file.replace(/\.log$/, ".json");
  const evidence = `${record2.output_file} (SHA-256 ${record2.output_hash})`;
  const failure = record2.exit_code === 0 ? `| Command ${record2.command_id} | No command-level failure observed; exit code was 0. | Exit code 0 | ${tableCell(evidence)} | none recorded by execution engine |` : `| Command ${record2.command_id}; case mapping ${NOT_REPORTED} | Configured command exited with code ${record2.exit_code}. | Exit code 0 | ${tableCell(evidence)} | none recorded by execution engine |`;
  return `---
id: RESULT-${record2.id}
artifact_type: test_result
title: ${JSON.stringify(`Result for ${record2.command_id}`)}
status: active
created_by_change: ${change}
depends_on: [TEST-POLICY]
decisions: []
implementation: []
supersedes:
execution_id: ${record2.id}
---
# RESULT-${record2.id} - Result for ${record2.command_id}

## Execution identity

- Execution ID: ${record2.id}
- Verification level: ${record2.level}
- Configured command ID: ${record2.command_id}
- Started at: ${record2.started_at}
- Finished at: ${record2.ended_at}
- Overall outcome: ${outcome} (derived from exit code ${record2.exit_code})

## Execution provenance

| Field | Engine-recorded value |
|---|---|
| Source revision | ${tableCell(record2.git_commit ?? "not available from source control")} |
| Source snapshot SHA-256 | ${record2.source_snapshot_hash} |
| Flow ID | ${record2.flow_id} |
| Change ID | ${change} |
| Command | ${tableCell(record2.command)} |
| Working directory | ${tableCell(record2.cwd)} |
| Toolchain | ${NOT_REPORTED} |
| Environment fingerprint | ${NOT_REPORTED} |

## Aggregate result

| Metric | Value |
|---|---|
| Total test cases | ${NOT_REPORTED} |
| Passed test cases | ${NOT_REPORTED} |
| Failed test cases | ${NOT_REPORTED} |
| Skipped test cases | ${NOT_REPORTED} |
| Command executions | 1 |
| Command outcome | ${outcome} |
| Duration | ${duration(record2)} |

## Case results

| Test spec ID | Case ID | Outcome | Duration | Evidence reference |
|---|---|---|---|---|
| ${NOT_REPORTED} | ${NOT_REPORTED} | ${NOT_REPORTED} | ${NOT_REPORTED} | ${tableCell(recordFile)} |

## Failures and evidence

| Test spec and case | Observed failure | Expected behavior | Diagnostic evidence | Related issue |
|---|---|---|---|---|
${failure}

## Integrity contract

- Execution record: \`${recordFile}\`.
- Output log: \`${record2.output_file}\`.
- Output log SHA-256: \`${record2.output_hash}\`.
- Source snapshot SHA-256: \`${record2.source_snapshot_hash}\`.
- This artifact is a deterministic projection of ${record2.id} and is not user-created or user-editable.
- Command outcome is derived only from the recorded exit code; case counts and test-spec mappings are never inferred.
- Output sanitization status is ${NOT_REPORTED}; the referenced log preserves the command output recorded by the engine.
`;
}

// src/core/execution-provenance.ts
init_utils();
async function executionProvenanceIssues(root2, record2) {
  const issues = [];
  const expectedOutput = `.ai-saas-sdlc/executions/${record2.id}.log`;
  if (record2.output_file.replaceAll("\\", "/") !== expectedOutput) issues.push(`output_file must be ${expectedOutput}`);
  if (Date.parse(record2.ended_at) < Date.parse(record2.started_at)) issues.push("ended_at precedes started_at");
  const logFile = path10.resolve(root2, record2.output_file);
  if (!isWithin(projectPaths(root2).executions, logFile)) issues.push("output_file escapes executions directory");
  else if (!await pathExists(logFile)) issues.push("execution log is missing");
  else {
    try {
      await assertSafeManagedPath(root2, logFile);
      if (!await isRealPathWithin(projectPaths(root2).executions, logFile)) issues.push("execution log escapes through a symlink");
      else if (sha256(await readFile9(logFile, "utf8")) !== record2.output_hash) issues.push("execution log digest does not match output_hash");
    } catch {
      issues.push("execution log cannot be resolved safely");
    }
  }
  return issues;
}
function resultBindingIssues(artifact2, record2) {
  const issues = [];
  if (artifact2.id !== `RESULT-${record2.id}`) issues.push(`result ID must be RESULT-${record2.id}`);
  if (artifact2.execution_id !== record2.id) issues.push(`execution_id must be ${record2.id}`);
  if (artifact2.hash !== sha256(renderResultArtifact(record2, artifact2.created_by_change))) issues.push("result content does not match its execution record");
  return issues;
}

// src/core/internal-validation.ts
init_record_validation();
