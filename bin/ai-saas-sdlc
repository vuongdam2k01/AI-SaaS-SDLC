function latestExecution(records) {
  return records.reduce((latest, record2) => {
    const sequence = Number(record2.id.slice("EXEC-".length));
    const latestSequence = latest ? Number(latest.id.slice("EXEC-".length)) : -1;
    return sequence > latestSequence ? record2 : latest;
  }, void 0);
}

