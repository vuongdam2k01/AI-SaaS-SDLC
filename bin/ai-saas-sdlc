    testTypes = /* @__PURE__ */ new Set(["unit_test_backend", "unit_test_frontend", "unit_test_job", "integration_test", "system_test"]);
    unitTypes = /* @__PURE__ */ new Set(["unit_test_backend", "unit_test_frontend", "unit_test_job"]);
  }
});

