async function codeProjectMarkers(root2) {
  let entries;
  try {
    entries = await readdir4(root2, { withFileTypes: true });
  } catch {
    return [];
  }
  return entries.filter((entry) => entry.isFile()).map((entry) => entry.name).filter((name) => CODE_PROJECT_MARKERS.has(name.toLowerCase()) || CODE_PROJECT_EXTENSIONS.has(path13.extname(name).toLowerCase())).sort();
}
async function initializeProjectUnlocked(root2, templateRoot, patternRoot, projectId, idea, force) {
  if (!/^[a-z0-9][a-z0-9-]*$/.test(projectId)) throw new SdlcError("project_id must use lowercase letters, numbers, and hyphens.");
  if (await pathExists(projectPaths(root2).config)) throw new SdlcError("Repository is already initialized.");
  if (!force) {
    const found = await codeProjectMarkers(root2);
    if (found.length > 0) throw new SdlcError(`Refusing to initialize: ${found.join(", ")} \u2014 this directory looks like a code project, and this engine manages a separate documentation repository. If this really is your documentation repository, re-run with --force.`);
  }
  const plan = await copyPlan(root2, templateRoot, patternRoot);
  const conflicts = [];
  for (const item of plan) {
    if (!isWithin(root2, item.target)) throw new SdlcError(`Initialization path escapes project root: ${item.relative}`);
    await assertNoSymlinkAncestor(root2, item.target);
    if (await pathExists(item.target)) conflicts.push(item.relative);
  }
  const snapshotFile = path13.join(root2, "00-system", "patterns", "snapshot.json");
  await assertNoSymlinkAncestor(root2, snapshotFile);
  if (await pathExists(snapshotFile)) conflicts.push("00-system/patterns/snapshot.json");
  if (conflicts.length > 0) throw new SdlcError(`Initialization would overwrite existing files: ${conflicts.join(", ")}`);
  for (const item of plan.sort((a, b2) => a.relative.localeCompare(b2.relative))) {
    await mkdir4(path13.dirname(item.target), { recursive: true });
    const sourceContent = await readFile9(item.source, "utf8");
    const content = item.substitute ? sourceContent.replaceAll("{{PROJECT_ID}}", projectId).replaceAll("{{RAW_IDEA}}", idea === "" ? "Not provided. Invoke /ai-saas-sdlc:genesis with the raw idea." : idea) : sourceContent;
    await writeFile4(item.target, content, { encoding: "utf8", flag: "wx" });
  }
  const pinnedRoot = path13.join(root2, "00-system", "patterns");
  const pinnedFiles = await (0, import_fast_glob8.default)("**/*", { cwd: pinnedRoot, onlyFiles: true, dot: true, followSymbolicLinks: false });
  const patternHashes = [];
  for (const relative of pinnedFiles.sort()) {
    const content = await readFile9(path13.join(pinnedRoot, relative), "utf8");
    patternHashes.push(`00-system/patterns/${relative.replaceAll("\\", "/")}:${sha256(content)}`);
  }
  await writeFile4(snapshotFile, stableJson({ schema_version: 1, catalog_hash: sha256(patternHashes.join("\n")), files: patternHashes.length }), { encoding: "utf8", flag: "wx" });
  const state = {
    schema_version: 1,
    project_id: projectId,
    active_baseline: null,
    evidence_revision: 0,
    next_change: 1,
    next_flow: 1,
    next_execution: 1,
    id_registry: {}
  };
  await saveCurrentState(root2, state);
  const paths = projectPaths(root2);
  await Promise.all([
    mkdir4(paths.changes, { recursive: true }),
    mkdir4(paths.executions, { recursive: true }),
    mkdir4(paths.retrievals, { recursive: true }),
    mkdir4(paths.cache, { recursive: true })
  ]);
}
async function initializeProject(root2, templateRoot, projectId, idea, patternRoot = path13.resolve(templateRoot, "..", "artifact-patterns"), options) {
  return withProjectLock(root2, () => initializeProjectUnlocked(root2, templateRoot, patternRoot, projectId, idea, options?.force === true));
}

