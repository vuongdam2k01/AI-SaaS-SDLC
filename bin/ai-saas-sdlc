import path12 from "node:path";
import { readdir as readdir3 } from "node:fs/promises";
async function loadBaseline(root2) {
  const file = projectPaths(root2).baseline;
  if (!await pathExists(file)) return null;
  await assertSafeManagedPath(root2, file);
  const baseline2 = await readJson(file);
  if (!isBaselineManifest(baseline2)) throw new SdlcError(`Invalid baseline manifest schema: ${file}`);
  return baseline2;
}
async function projectSnapshot(root2) {
  const artifacts = await scanArtifacts(root2);
  const baseline2 = await loadBaseline(root2);
  const graph = buildGraph(artifacts);
  return { artifacts, baseline: baseline2, impact: calculateImpact(artifacts, graph, baseline2) };
}
async function refreshProjectUnlocked(root2, check) {
  const artifacts = await scanArtifacts(root2);
  const graph = buildGraph(artifacts);
  const baseline2 = await loadBaseline(root2);
  const impact2 = calculateImpact(artifacts, graph, baseline2);
  const flow2 = await loadActiveFlow(root2);
  const activeChange = flow2?.change_id && impact2.direct.length > 0 ? flow2.change_id : null;
  let config = null;
  try {
    config = await loadConfig(root2);
  } catch {
    config = null;
  }
  const records = await loadExecutionRecords(root2);
  const retrievals = await loadRetrievalRecords(root2);
  const queries = await loadQueryRecords(root2);
  const drifted = config && config.implementation_sources.length > 0 && baseline2?.implementation_hashes ? new Set((await driftedMappings(root2, config, artifacts, baseline2)).map((entry) => entry.mapping)) : void 0;
  const activeLedger = activeChange ? (await loadChange(root2, activeChange).catch(() => null))?.classification ?? {} : void 0;
  const projections = buildProjections(artifacts, graph, impact2, baseline2, activeChange, config, records, retrievals, queries, drifted, activeLedger);
  if (await pathExists(projectPaths(root2).changes)) {
    await assertSafeManagedPath(root2, path12.join(projectPaths(root2).changes, ".managed-probe"));
    for (const entry of await readdir3(projectPaths(root2).changes, { withFileTypes: true })) if (entry.isSymbolicLink() && /^CHG-.*\.json$/.test(entry.name)) throw new SdlcError(`Change record cannot be a symlink: ${entry.name}`);
    const changeFiles = await (0, import_fast_glob7.default)("CHG-*.json", { cwd: projectPaths(root2).changes, absolute: true, followSymbolicLinks: false });
    for (const file of changeFiles) {
      await assertSafeManagedPath(root2, file);
      try {
        const change = await readJson(file);
        if (isChangeRecord(change) && change.impact) {
          projections[`change-impact/${change.id}.md`] = changeImpactProjection(change.id, change.impact, change.classification);
        }
      } catch {
      }
    }
  }
  return applyProjections(root2, projections, check);
}
async function refreshProject(root2, check) {
  return check ? refreshProjectUnlocked(root2, true) : withProjectLock(root2, () => refreshProjectUnlocked(root2, false));
}
async function loadChange(root2, id2) {
  if (!/^CHG-[0-9]{3,}$/.test(id2)) throw new SdlcError(`Invalid change ID: ${id2}`);
  const file = path12.join(projectPaths(root2).changes, `${id2}.json`);
  if (!await pathExists(file)) return null;
  await assertSafeManagedPath(root2, file);
  const change = await readJson(file);
  if (!isChangeRecord(change)) throw new SdlcError(`Invalid change record schema: ${file}`);
  return change;
}
