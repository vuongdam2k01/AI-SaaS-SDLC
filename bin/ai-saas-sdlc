import path9 from "node:path";
import { mkdir as mkdir5, readFile as readFile8, writeFile as writeFile4 } from "node:fs/promises";
var ENGINE_POINTER_FILE = path9.join(INTERNAL_DIR, "engine.json");
var IGNORE_ENTRY = ".ai-saas-sdlc/engine.json";
function quoted(target) {
  return `node "${target.replace(/\\/g, "/")}"`;
}
function buildEnginePointer(runtimeRoot2, pluginVersion) {
  const enginePath = path9.join(runtimeRoot2, "bin", "ai-saas-sdlc");
  return {
    schema_version: 1,
    plugin_version: pluginVersion,
    engine_path: enginePath,
    editorial_command: `${quoted(enginePath)} refresh --editorial`
  };
}
async function recordEnginePointer(root2, runtimeRoot2, pluginVersion) {
  const target = path9.join(root2, ENGINE_POINTER_FILE);
  const pointer = buildEnginePointer(runtimeRoot2, pluginVersion);
  const serialized = `${JSON.stringify(pointer, null, 2)}
`;
  if (await pathExists(target)) {
    const existing = await readFile8(target, "utf8").catch(() => "");
    if (existing === serialized) return;
  }
  await mkdir5(path9.dirname(target), { recursive: true });
  await writeFile4(target, serialized, "utf8");
}
async function ensureEnginePointerIgnored(root2) {
  const target = path9.join(root2, ".gitignore");
  const existing = await pathExists(target) ? await readFile8(target, "utf8").catch(() => "") : "";
  if (existing.split(/\r?\n/).some((line) => line.trim() === IGNORE_ENTRY)) return;
  const prefix = existing === "" || existing.endsWith("\n") ? existing : `${existing}
`;
  await writeFile4(target, `${prefix}${IGNORE_ENTRY}
`, "utf8");
}

