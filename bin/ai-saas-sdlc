// src/core/projections.ts
import { mkdir as mkdir3, readFile as readFile8, rm as rm2, writeFile as writeFile3 } from "node:fs/promises";
import path11 from "node:path";
function changeImpactProjection(changeId, impact2, classification) {
  const closure = `# Change Impact: ${changeId}

## Direct

${impact2.direct.map((id2) => `- \`${id2}\``).join("\n") || "None."}

## Affected closure

${impact2.affected.map((id2) => `- \`${id2}\``).join("\n") || "None."}
`;
  if (!classification) return closure;
  const rows = [
    ...impact2.direct.map((id2) => [`\`${id2}\``, "modify (direct)", "Edited by this change."]),
    ...(impact2.ripple ?? []).map((id2) => {
      const decision = classification[id2];
      return [`\`${id2}\``, decision ? decision.label : "unclassified", decision?.reason ?? "\u2014"];
    })
  ];
  return `${closure}
## Classification

A direct change is the modify decision. Every artifact this change's revisions put in question carries the decision recorded through \`impact classify\`; \`unclassified\` is what IMPACT_UNCLASSIFIED reports. Artifacts reached only as prerequisites of something this change created are not decisions and are not listed.

${table3(["Artifact", "Decision", "Reason"], rows)}`;
}
function table3(headers3, rows) {
  const head = `| ${headers3.join(" | ")} |`;
  const line = `| ${headers3.map(() => "---").join(" | ")} |`;
  return `${head}
${line}
${rows.map((row) => `| ${row.join(" | ")} |`).join("\n") || `| ${headers3.map(() => "\u2014").join(" | ")} |`}
`;
}
function platformEvidenceState(target, declared, records) {
  if (!isLiveStatus(target.status)) return "not live";
  if (!declared.has(target.id)) return "missing";
  const declaring = records.filter((record2) => (record2.platforms ?? []).includes(target.id));
  if (declaring.length === 0) return "declared, not executed";
  if (!declaring.some((record2) => record2.host)) return "executed, host unrecorded";
  if (!target.host_os) return "observed";
  return platformContradiction(target, records) ? "contradicted" : "observed on declared host";
}
function platformCoverageProjection(artifacts, config, records) {
  const targets = artifacts.filter((artifact2) => artifact2.artifact_type === "platform_target").sort((a, b2) => a.id.localeCompare(b2.id));
  const declared = declaredPlatformIds(config);
  const levels = ["unit", "integration", "system"];
  const declaringCommands = (targetId) => config ? levels.flatMap((level) => config.verification[level].filter((command) => (command.platforms ?? []).includes(targetId)).map((command) => `${level}:${command.id}`)) : [];
  const targetRows = targets.map((target) => {
    const observed = uniqueSorted(records.filter((record2) => (record2.platforms ?? []).includes(target.id) && record2.host).map((record2) => record2.host?.os ?? ""));
    return [
      `\`${target.id}\``,
      target.status,
      target.host_os ?? "\u2014",
      declaringCommands(target.id).map((value) => `\`${value}\``).join(", ") || "none",
      observed.join(", ") || "\u2014",
      platformEvidenceState(target, declared, records)
    ];
  });
  const commandRows = config ? levels.flatMap((level) => config.verification[level].filter((command) => command.platforms).map((command) => {
    const latest = latestExecution(records.filter((record2) => record2.level === level && matchesDefinitionEvidence(record2, command)));
    return [
      level,
      `\`${command.id}\``,
      (command.platforms ?? []).map((value) => `\`${value}\``).join(", "),
      latest ? `\`${latest.id}\`` : "none",
      latest ? String(latest.exit_code) : "\u2014",
      latest ? latest.host?.os ?? "not recorded" : "\u2014",
      latest ? latest.ended_at : "\u2014"
    ];
  })) : [];
  const liveTargetIds = new Set(livePlatformTargets(artifacts).map((target) => target.id));
  const unknown = [...declared].filter((declaration) => !liveTargetIds.has(declaration)).sort();
  return `# Platform Coverage

Declarations are human claims; recorded hosts are machine facts. This view joins them without merging them.

## Targets

${table3(
    ["Target", "Status", "Declared host_os", "Declaring commands", "Observed hosts", "Evidence state"],
    targetRows
  )}
## Declaring commands

A row matches executions through the same predicate the baseline verdict uses: identical command identity, text, working directory and platform declaration. Unlike the verdict, it looks across every flow \u2014 latest evidence ever, not latest in the active flow.

${table3(
    ["Level", "Command", "Declares", "Latest matching execution", "Exit code", "Observed host", "Finished at"],
    commandRows
  )}
## Unknown declarations

${unknown.map((declaration) => `- \`${declaration}\``).join("\n") || "None."}
`;
}
function projectionCell2(value) {
  return value.replaceAll("|", "\\|");
}
function retrievalCoverageSections(retrievals, queries) {
  const retrievalRows = retrievals.map((record2) => [
    `\`${record2.id}\``,
    projectionCell2(record2.url),
    `${record2.instrument}${record2.escalation ? " (escalated)" : ""}`,
    record2.via,
    String(record2.capability_rung),
    record2.ok ? "ok" : "failed",
    record2.ok ? `${record2.body_bytes}B${record2.truncated ? " (truncated)" : ""}` : "\u2014"
  ]);
  const queryRows = queries.map((record2) => [
    `\`${record2.id}\``,
    record2.kind,
    record2.pass ?? "\u2014",
    projectionCell2(record2.query || record2.url || ""),
    record2.ok ? String(record2.result_count) : "failed",
    (record2.unresponsive_engines ?? []).map(projectionCell2).join(", ") || "\u2014"
  ]);
  const count = (predicate) => ({
    searxng: queries.filter((record2) => record2.instrument === "searxng" && predicate(record2.ok)).length,
    firecrawlQueries: queries.filter((record2) => record2.instrument === "firecrawl" && predicate(record2.ok)).length,
    firecrawl: retrievals.filter((record2) => record2.instrument === "firecrawl" && predicate(record2.ok)).length,
    camofox: retrievals.filter((record2) => record2.instrument === "camofox" && predicate(record2.ok)).length
  });
  const ok = count((value) => value);
  const failed = count((value) => !value);
  return `
## Retrieval provenance

Engine-performed page retrievals; each row is an immutable record under \`.ai-saas-sdlc/retrievals/\` with a hashed stored body.

${table3(
    ["Record", "URL", "Instrument", "Via", "Rung", "Outcome", "Body"],
    retrievalRows
  )}
## Query passes

${table3(
    ["Record", "Kind", "Pass", "Query", "Results", "Unresponsive engines"],
    queryRows
  )}
## Instrument usage

- SearXNG searches: ${ok.searxng} ok, ${failed.searxng} failed
- Firecrawl maps: ${ok.firecrawlQueries} ok, ${failed.firecrawlQueries} failed
- Firecrawl retrievals: ${ok.firecrawl} ok, ${failed.firecrawl} failed
- Camofox retrievals: ${ok.camofox} ok, ${failed.camofox} failed
`;
}
function buildProjections(artifacts, graph, impact2, baseline2, activeChange, config, records, retrievals = [], queries = [], driftedImplementationMappings, activeClassification) {
  const projections = {};
  projections["artifact-graph.json"] = stableJson(graph);
  projections["artifact-index.md"] = `# Artifact Index

${table3(
    ["ID", "Type", "Status", "Source"],
    graph.nodes.map((node) => [`\`${node.id}\``, node.type, node.status, `\`${node.file}\``])
  )}`;
  projections["traceability.md"] = `# Traceability

Relations are declared by the downstream artifact. Reverse views are generated.

${table3(
    ["Downstream", "Relation", "Upstream"],
    graph.edges.map((edge) => [`\`${edge.from}\``, edge.relation, `\`${edge.to}\``])
  )}`;
  const evidence = artifacts.find((item) => item.artifact_type === "evidence_ledger");
  const evidenceIds = evidence?.body.match(/^## EVD-[A-Z0-9-]+/gm)?.map((value) => value.slice(3)) ?? [];
  const discoveryTypes = ["idea_definition", "market_landscape", "customer_and_problem", "competitive_and_commercial", "feasibility_and_risk", "opportunity_definition"];
  projections["research-coverage.md"] = `# Research Coverage

- Evidence entries: **${evidenceIds.length}**
- Research mode: **public-web-only**

${table3(
    ["Area", "Artifact", "Status"],
    discoveryTypes.map((type) => {
      const artifact2 = artifacts.find((item) => item.artifact_type === type);
      return [type, artifact2 ? `\`${artifact2.id}\`` : "missing", artifact2?.status ?? "missing"];
    })
  )}${retrievals.length + queries.length > 0 ? retrievalCoverageSections(retrievals, queries) : ""}`;
  projections["evidence-claim-coverage.md"] = evidenceClaimCoverage(artifacts);
  projections["acceptance-coverage.md"] = acceptanceCoverage(artifacts);
  projections["rule-coverage.md"] = ruleCoverage(artifacts);
  if (foundationCoverageEntries(artifacts).length > 0) {
    projections["foundation-coverage.md"] = foundationCoverage(artifacts);
  }
  if (artifacts.some((artifact2) => artifact2.artifact_type === "screen")) {
    projections["screen-coverage.md"] = screenCoverage(artifacts);
  }
  if (artifacts.some((artifact2) => artifact2.artifact_type === "platform_target")) {
    projections["platform-coverage.md"] = platformCoverageProjection(artifacts, config, records);
  }
  const nodesById = new Map(graph.nodes.map((node) => [node.id, node]));
  const featureRows = graph.nodes.filter((node) => node.type === "feature").map((feature) => {
    const consumers = graph.edges.filter((edge) => edge.to === feature.id).map((edge) => nodesById.get(edge.from)).filter(Boolean);
    const types = uniqueSorted(consumers.map((node) => node?.type ?? ""));
    return [`\`${feature.id}\``, feature.status, types.join(", ") || "none"];
  });
  projections["feature-coverage.md"] = `# Feature Coverage

${table3(["Feature", "Status", "Direct downstream types"], featureRows)}`;
  const writers = /* @__PURE__ */ new Map();
  for (const node of graph.nodes) for (const target of node.writes_to) writers.set(target, [...writers.get(target) ?? [], node.id]);
  projections["interaction-map.md"] = `# Interaction Map

${table3(
    ["Shared target", "Writers", "Conflict review"],
    [...writers.entries()].sort(([a], [b2]) => a.localeCompare(b2)).map(([target, ids]) => [target, uniqueSorted(ids).map((id2) => `\`${id2}\``).join(", "), ids.length > 1 ? "required" : "single writer"])
  )}`;
  projections["implementation-map.md"] = `# Implementation Map

${table3(
    ["Artifact", "Implementation paths"],
    graph.nodes.filter((node) => node.implementation.length > 0).map((node) => [`\`${node.id}\``, node.implementation.map((value) => `\`${value}\``).join(", ")])
  )}`;
  const order = topologicalOrder(graph);
  projections["implementation-order.md"] = `# Implementation Order

${order.order.map((id2, index) => `${index + 1}. \`${id2}\``).join("\n") || "No artifacts."}
`;
  if (config && config.implementation_sources.length > 0) {
    projections["implementation-coverage.md"] = implementationCoverageProjection(artifacts, graph, config, records, driftedImplementationMappings);
    Object.assign(projections, implementationPlanProjections(artifacts, graph, config));
  }
  projections["stale-artifacts.md"] = `# Stale Artifacts

Baseline: **${baseline2?.id ?? "none"}**

${impact2.stale.map((id2) => `- \`${id2}\``).join("\n") || "No indirectly affected artifacts."}
`;
  projections["issue-index.md"] = `# Issue Index

${table3(
    ["ID", "Status", "Title"],
    artifacts.filter((item) => item.artifact_type === "issue").map((item) => [`\`${item.id}\``, item.status, item.title])
  )}`;
  const decisions = artifacts.filter((item) => item.artifact_type === "architectural_decision");
  const supersededBy = /* @__PURE__ */ new Map();
  for (const decision of decisions) {
    if (!decision.supersedes) continue;
    supersededBy.set(decision.supersedes, [...supersededBy.get(decision.supersedes) ?? [], decision.id]);
  }
  projections["decision-index.md"] = `# Decision Index

${table3(
    ["ID", "Decision status", "Artifact status", "In force", "Title", "Supersedes", "Superseded by"],
    decisions.map((item) => {
      const successors = supersededBy.get(item.id) ?? [];
      return [
        `\`${item.id}\``,
        item.adr_status ?? "",
        item.status,
        successors.length > 0 ? "no" : "yes",
        item.title,
        item.supersedes ? `\`${item.supersedes}\`` : "\u2014",
        successors.length > 0 ? successors.map((id2) => `\`${id2}\``).join(", ") : "\u2014"
      ];
    })
  )}`;
  for (const adr of artifacts.filter((item) => item.artifact_type === "architectural_decision")) {
    const affected = graph.edges.filter((edge) => edge.relation === "decision" && edge.to === adr.id).map((edge) => edge.from);
    const successors = graph.edges.filter((edge) => edge.relation === "supersedes" && edge.to === adr.id).map((edge) => edge.from);
    projections[`decision-impact/${adr.id}.md`] = `# Decision Impact: ${adr.id}

## Current dependents

${affected.map((id2) => `- \`${id2}\``).join("\n") || "No artifact currently declares this decision."}

## Successors

${successors.map((id2) => `- \`${id2}\``).join("\n") || "No successor."}
`;
  }
  if (activeChange) {
    projections[`change-impact/${activeChange}.md`] = changeImpactProjection(activeChange, impact2, activeClassification);
  }
  return projections;
}
async function applyProjections(root2, projections, check) {
  const base = projectPaths(root2).generated;
  const drift = [];
  const protect = check ? assertSafeManagedPath : prepareSafeManagedPath;
  await protect(root2, path11.join(base, ".managed-probe"));
  for (const [relative, expectedRaw] of Object.entries(projections).sort(([a], [b2]) => a.localeCompare(b2))) {
    const file = path11.join(base, relative);
    if (!isWithin(base, file)) throw new Error(`Projection path escapes generated directory: ${relative}`);
    await protect(root2, file);
    const expected = normalizeText(expectedRaw);
    let actual = "";
    if (await pathExists(file)) actual = normalizeText(await readFile8(file, "utf8"));
    if (actual !== expected) {
      drift.push(relative);
      if (!check) {
        await mkdir3(path11.dirname(file), { recursive: true });
        await writeFile3(file, expected, "utf8");
      }
    }
  }
  if (await pathExists(base)) {
    const expectedFiles = new Set(Object.keys(projections).map((value) => value.replaceAll("\\", "/")));
    const existing = await (0, import_fast_glob6.default)("**/*", { cwd: base, onlyFiles: true, dot: true });
    for (const relative of existing.sort()) {
      if (relative.endsWith(".gitkeep") || relative === "baseline-manifest.json" || expectedFiles.has(relative.replaceAll("\\", "/"))) continue;
      drift.push(`unexpected:${relative.replaceAll("\\", "/")}`);
      if (!check) {
        const file = path11.join(base, relative);
        if (!isWithin(base, file)) throw new Error(`Unexpected projection escapes generated directory: ${relative}`);
        await prepareSafeManagedPath(root2, file);
        await rm2(file);
      }
    }
  }
  return drift.sort();
}
