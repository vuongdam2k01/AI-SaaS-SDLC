  const rows = evidenceIds.map((evidenceId) => {
    const consumers = artifacts.filter((artifact2) => artifact2.id !== ledger?.id && new RegExp(`\\b${evidenceId}\\b`).test(artifact2.body)).map((artifact2) => artifact2.id);
    return [`\`${evidenceId}\``, cell(consumers), consumers.length > 0 ? "consumed" : "unconsumed"];
  });
  return `# Evidence-to-Claim Coverage

This projection shows which canonical synthesis artifacts explicitly consume each evidence entry.

${table(["Evidence", "Referenced by", "Status"], rows)}`;
}
function acceptanceStatus(hasBehavior, hasTests) {
  if (hasBehavior && hasTests) return "covered";
  if (!hasTests && !hasBehavior) return "unclaimed";
  return hasTests ? "unrouted" : "unverified";
}
function acceptanceCoverage(artifacts) {
  const acceptanceIds = artifacts.filter((artifact2) => artifact2.artifact_type === "feature" && artifact2.status !== "retired" && artifact2.status !== "superseded").flatMap((artifact2) => bodyIds(artifact2.body, /\bAC-[A-Z0-9-]+\b/g).map((id2) => ({ id: id2, feature: artifact2.id })));
  const rows = acceptanceIds.map(({ id: id2, feature }) => {
    const qualified = `${feature}#${id2}`;
    const consumers = artifacts.filter((artifact2) => artifact2.id !== feature && claimsLocalId(artifact2, feature, id2));
    const behavior = consumers.filter((artifact2) => behaviorTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    const design = consumers.filter((artifact2) => designTypes.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    const tests2 = consumers.filter((artifact2) => TEST_TYPES.has(artifact2.artifact_type)).map((artifact2) => artifact2.id);
    return [`\`${qualified}\``, `\`${feature}\``, cell(behavior), cell(design), cell(tests2), acceptanceStatus(behavior.length > 0, tests2.length > 0)];
  });
  return `# Acceptance Coverage

Design is conditional; behavior and verification references are required for complete coverage.

A criterion is \`covered\` only when both references exist. The two ways of falling short are reported separately, because they are different debts: \`unverified\` is a criterion no test specification claims, and \`unrouted\` is a criterion tests do claim but no use case or flow carries. Reading \`unrouted\` as missing verification overstates the gap.

${table(["Acceptance criterion", "Feature", "Behavior", "Design", "Tests", "Status"], rows)}`;
}
