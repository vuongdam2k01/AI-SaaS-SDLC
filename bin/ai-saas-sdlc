// src/core/state.ts
import { access, rm as rm3 } from "node:fs/promises";
async function snapshotHash(root2) {
  const artifacts = await scanArtifacts(root2);
  return sha256(stableJson(artifacts.map((artifact2) => ({ id: artifact2.id, file: artifact2.file, hash: artifact2.hash, status: artifact2.status }))));
}
async function pathExists(file) {
  try {
    await access(file);
    return true;
  } catch {
    return false;
  }
}
async function loadCurrentState(root2) {
  const file = projectPaths(root2).current;
  if (!await pathExists(file)) throw new SdlcError("Repository is not initialized. Run ai-saas-sdlc init.");
  await assertSafeManagedPath(root2, file);
  const candidate = await readJson(file);
  if (!candidate || typeof candidate !== "object" || Array.isArray(candidate)) throw new SdlcError(`Invalid state schema: ${file}`);
  const state = candidate;
  const questionAges = state.question_first_baseline;
  const valid = Object.keys(state).every((key) => ["schema_version", "project_id", "active_baseline", "evidence_revision", "next_change", "next_flow", "next_execution", "id_registry", "question_first_baseline"].includes(key)) && state.schema_version === 1 && typeof state.project_id === "string" && /^[a-z0-9][a-z0-9-]*$/.test(state.project_id) && (state.active_baseline === null || /^BL-[0-9]{3,}$/.test(state.active_baseline)) && [state.evidence_revision, state.next_change, state.next_flow, state.next_execution].every(Number.isInteger) && state.evidence_revision >= 0 && state.next_change >= 1 && state.next_flow >= 1 && state.next_execution >= 1 && Boolean(state.id_registry) && typeof state.id_registry === "object" && !Array.isArray(state.id_registry) && Object.keys(state.id_registry).every((key) => /^[A-Z][A-Z0-9-]*$/.test(key)) && Object.values(state.id_registry).every((value) => typeof value === "string") && (questionAges === void 0 || typeof questionAges === "object" && questionAges !== null && !Array.isArray(questionAges) && Object.keys(questionAges).every((key) => /^QST-[A-Z0-9-]+$/.test(key)) && Object.values(questionAges).every((value) => typeof value === "string" && /^BL-[0-9]{3,}$/.test(value)));
  if (!valid) throw new SdlcError(`Invalid state schema: ${file}`);
  return state;
}
async function saveCurrentState(root2, state) {
  await prepareSafeManagedPath(root2, projectPaths(root2).current);
  await writeJsonAtomic(projectPaths(root2).current, state);
}
async function loadActiveFlow(root2) {
  const file = projectPaths(root2).activeFlow;
  if (!await pathExists(file)) return null;
  await assertSafeManagedPath(root2, file);
  const flow2 = await readJson(file);
  if (!isActiveFlow(flow2)) throw new SdlcError(`Invalid active flow schema: ${file}`);
  return flow2;
}
async function startFlowUnlocked(root2, type, input, targetStage) {
  if (!FLOW_TYPES.includes(type)) throw new SdlcError(`Unsupported flow type: ${type}`);
  if (await loadActiveFlow(root2)) throw new SdlcError("An active flow already exists. Close it before starting another.");
  const state = await loadCurrentState(root2);
  if (type === "genesis" && state.active_baseline) throw new SdlcError("Genesis is only valid before the first product baseline.");
  if (type !== "genesis" && !state.active_baseline) throw new SdlcError(`${type} requires an existing product baseline.`);
  const semantic = type === "evolution" || type === "reconciliation";
  const changeId = semantic ? formatId("CHG", state.next_change) : null;
  const flow2 = {
    schema_version: 1,
    id: formatId("FLOW", state.next_flow),
    type,
    input,
    started_at: (/* @__PURE__ */ new Date()).toISOString(),
    base_baseline: state.active_baseline,
    change_id: changeId,
    stop_blocked_once: false,
    start_snapshot_hash: await snapshotHash(root2),
    implementation_snapshot_hash: await implementationSnapshotHash(root2),
    ...targetStage ? { target_stage: targetStage } : {}
  };
  state.next_flow += 1;
  if (semantic) state.next_change += 1;
  await saveCurrentState(root2, state);
  await prepareSafeManagedPath(root2, projectPaths(root2).activeFlow);
  await writeJsonAtomic(projectPaths(root2).activeFlow, flow2);
  if (changeId) {
    const changeFile = `${projectPaths(root2).changes}/${changeId}.json`;
    await prepareSafeManagedPath(root2, changeFile);
    await writeJsonAtomic(changeFile, {
      schema_version: 1,
      id: changeId,
      flow_id: flow2.id,
      type,
      input,
      status: "active",
      base_baseline: state.active_baseline,
      started_at: flow2.started_at
    });
  }
  return flow2;
}
async function checkpointFlow(root2, reached, target) {
  return withProjectLock(root2, async () => {
    if (!FLOW_STAGES.includes(reached)) throw new SdlcError(`Unsupported flow stage: ${reached}. Expected ${FLOW_STAGES.join("|")}.`);
    if (target !== void 0 && !FLOW_STAGES.includes(target)) throw new SdlcError(`Unsupported flow stage: ${target}. Expected ${FLOW_STAGES.join("|")}.`);
    const flow2 = await loadActiveFlow(root2);
    if (!flow2) throw new SdlcError("No active flow exists. A checkpoint only describes a flow that is open.");
    const furthest = flow2.reached_stage && stageIndex(flow2.reached_stage) > stageIndex(reached) ? flow2.reached_stage : reached;
    const updated = {
      ...flow2,
      reached_stage: furthest,
      ...target !== void 0 ? { target_stage: target } : {}
    };
    await prepareSafeManagedPath(root2, projectPaths(root2).activeFlow);
    await writeJsonAtomic(projectPaths(root2).activeFlow, updated);
    return updated;
  });
}
async function startFlow(root2, type, input, targetStage) {
  return withProjectLock(root2, () => startFlowUnlocked(root2, type, input, targetStage));
}
async function closeFlowUnlocked(root2) {
  const flow2 = await loadActiveFlow(root2);
  if (!flow2) throw new SdlcError("No active flow exists.");
  const snapshot = await Promise.resolve().then(() => (init_project(), project_exports)).then(({ projectSnapshot: projectSnapshot2 }) => projectSnapshot2(root2));
  const currentImplementation = await implementationSnapshotHash(root2);
  const cancelled = !flow2.baseline_created && await snapshotHash(root2) === flow2.start_snapshot_hash && currentImplementation === flow2.implementation_snapshot_hash;
  if (!flow2.baseline_created && !cancelled) throw new SdlcError(`Flow ${flow2.id} has unbaselined changes and cannot close: ${snapshot.impact.direct.join(", ") || "snapshot changed"}`);
  if (flow2.baseline_created && snapshot.impact.direct.length > 0) throw new SdlcError(`Flow ${flow2.id} has changes made after baseline ${flow2.baseline_created}: ${snapshot.impact.direct.join(", ")}`);
  if (flow2.baseline_created && currentImplementation !== flow2.baseline_implementation_snapshot_hash) throw new SdlcError(`Flow ${flow2.id} has implementation changes made after baseline ${flow2.baseline_created}.`);
  if (flow2.change_id) {
    const changeFile = `${projectPaths(root2).changes}/${flow2.change_id}.json`;
    await assertSafeManagedPath(root2, changeFile);
    const change = await readJson(changeFile);
    if (!isChangeRecord(change)) throw new SdlcError(`Invalid change record schema: ${changeFile}`);
    await prepareSafeManagedPath(root2, changeFile);
    await writeJsonAtomic(changeFile, cancelled ? { ...change, status: "cancelled", closed_at: (/* @__PURE__ */ new Date()).toISOString() } : { ...change, status: "closed", closed_at: (/* @__PURE__ */ new Date()).toISOString() });
  }
  await prepareSafeManagedPath(root2, projectPaths(root2).activeFlow);
  await rm3(projectPaths(root2).activeFlow);
  return flow2;
}
async function closeFlow(root2) {
  return withProjectLock(root2, () => closeFlowUnlocked(root2));
}
