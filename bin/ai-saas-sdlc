function deriveContractId(kind, relativeFile) {
  const stem = path3.posix.basename(toPosix(relativeFile)).replace(/\.[^.]*$/, "");
  const slug = stem.toUpperCase().replace(/[^A-Z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  return `${kind.id_prefix}${slug}`;
}
