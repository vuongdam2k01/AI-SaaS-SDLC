// src/core/retrieval-records.ts
import path8 from "node:path";
import { readdir as readdir2, writeFile as writeFile2 } from "node:fs/promises";
function retrievalBodyFile(id2) {
  return `.ai-saas-sdlc/retrievals/${id2}.md`;
}
async function allocateRetrievalIds(root2, count) {
  if (!Number.isInteger(count) || count < 1) throw new SdlcError("Retrieval allocation requires a positive count.");
  return withProjectLock(root2, async () => {
    const state = await loadCurrentState(root2);
    const ids = [];
    let next = state.next_retrieval ?? 1;
    for (let index = 0; index < count; index += 1) {
      const id2 = formatId("RET", next);
      const recordFile = path8.join(projectPaths(root2).retrievals, `${id2}.json`);
      const bodyFile = path8.join(projectPaths(root2).retrievals, `${id2}.md`);
      if (await pathExists(recordFile) || await pathExists(bodyFile)) throw new SdlcError(`Retrieval ID ${id2} is already reserved; repair state without overwriting provenance.`);
      await prepareSafeManagedPath(root2, recordFile);
      await prepareSafeManagedPath(root2, bodyFile);
      ids.push(id2);
      next += 1;
    }
    state.next_retrieval = next;
    await saveCurrentState(root2, state);
    return ids;
  });
}
async function allocateQueryId(root2) {
  return withProjectLock(root2, async () => {
    const state = await loadCurrentState(root2);
    const next = state.next_query ?? 1;
    const id2 = formatId("QRY", next);
    const recordFile = path8.join(projectPaths(root2).retrievals, `${id2}.json`);
    if (await pathExists(recordFile)) throw new SdlcError(`Query ID ${id2} is already reserved; repair state without overwriting provenance.`);
    await prepareSafeManagedPath(root2, recordFile);
    state.next_query = next + 1;
    await saveCurrentState(root2, state);
    return id2;
  });
}
async function writeRetrievalRecord(root2, record2, body) {
  const recordId = record2.id;
  if (!isRetrievalRecord(record2)) throw new SdlcError(`Malformed retrieval record: ${recordId}`);
  if (record2.ok !== (body !== void 0)) throw new SdlcError(`Retrieval ${record2.id}: a successful record requires a body and a failed record forbids one.`);
  return withProjectLock(root2, async () => {
    const recordFile = path8.join(projectPaths(root2).retrievals, `${record2.id}.json`);
    const bodyFile = path8.join(projectPaths(root2).retrievals, `${record2.id}.md`);
    if (await pathExists(recordFile)) throw new SdlcError(`Retrieval record ${record2.id} already exists; provenance is immutable.`);
    await prepareSafeManagedPath(root2, recordFile);
    if (body !== void 0) {
      const normalized = normalizeText(body);
      if (record2.body_file !== retrievalBodyFile(record2.id)) throw new SdlcError(`Retrieval ${record2.id}: body_file must be ${retrievalBodyFile(record2.id)}.`);
      if (record2.body_hash !== sha256(normalized)) throw new SdlcError(`Retrieval ${record2.id}: body_hash does not match the body being written.`);
      await prepareSafeManagedPath(root2, bodyFile);
      await writeFile2(bodyFile, normalized, "utf8");
    }
    await writeJsonAtomic(recordFile, record2);
  });
}
async function writeQueryRecord(root2, record2) {
  const recordId = record2.id;
  if (!isQueryRecord(record2)) throw new SdlcError(`Malformed query record: ${recordId}`);
  return withProjectLock(root2, async () => {
    const recordFile = path8.join(projectPaths(root2).retrievals, `${record2.id}.json`);
    if (await pathExists(recordFile)) throw new SdlcError(`Query record ${record2.id} already exists; provenance is immutable.`);
    await prepareSafeManagedPath(root2, recordFile);
    await writeJsonAtomic(recordFile, record2);
  });
}
async function loadRecords(root2, pattern, guard) {
  const directory = projectPaths(root2).retrievals;
  if (!await pathExists(directory)) return [];
  try {
    await assertSafeManagedPath(root2, path8.join(directory, ".managed-probe"));
  } catch {
    return [];
  }
  const symlinks = /* @__PURE__ */ new Set();
  for (const entry of await readdir2(directory, { withFileTypes: true })) if (entry.isSymbolicLink()) symlinks.add(entry.name);
  const files = await (0, import_fast_glob5.default)(pattern, { cwd: directory, absolute: true, followSymbolicLinks: false });
  const records = [];
  for (const file of files) {
    if (symlinks.has(path8.basename(file))) continue;
    try {
      await assertSafeManagedPath(root2, file);
      const record2 = await readJson(file);
      if (!guard(record2) || path8.basename(file) !== `${record2.id}.json`) continue;
      records.push(record2);
    } catch {
    }
  }
  return records.sort((a, b2) => a.id.localeCompare(b2.id));
}
