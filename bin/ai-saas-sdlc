// src/core/mapping-hashes.ts
import { readFile as readFile6 } from "node:fs/promises";
import path9 from "node:path";
async function collectMappingHashes(root2, config, artifacts) {
  const hashes = {};
  const sourceById = new Map(config.implementation_sources.map((source) => [source.id, path9.resolve(root2, source.path)]));
  const mappings = new Set(artifacts.flatMap((artifact2) => artifact2.implementation));
  for (const mapping of [...mappings].sort()) {
    const separator = mapping.indexOf(":");
    if (separator <= 0) continue;
    const sourceRoot = sourceById.get(mapping.slice(0, separator));
    if (!sourceRoot) continue;
    const target = path9.resolve(sourceRoot, mapping.slice(separator + 1));
    if (!target.startsWith(sourceRoot) || !await pathExists(target)) continue;
    try {
      hashes[mapping] = sha256(await readFile6(target, "utf8"));
    } catch {
    }
  }
  return hashes;
}
async function driftedMappings(root2, config, artifacts, baseline2) {
  const stored = baseline2?.implementation_hashes;
  if (!stored) return [];
  const baselineArtifactHashes = new Map((baseline2?.artifacts ?? []).map((entry) => [entry.id, entry.hash]));
  const current = await collectMappingHashes(root2, config, artifacts);
  const drifted = [];
  for (const [mapping, storedHash] of Object.entries(stored).sort(([a], [b2]) => a.localeCompare(b2))) {
    const currentHash = current[mapping];
    if (!currentHash || currentHash === storedHash) continue;
    const declaring = artifacts.filter((artifact2) => artifact2.implementation.includes(mapping));
    const unchanged = declaring.filter((artifact2) => baselineArtifactHashes.get(artifact2.id) === artifact2.hash);
    if (declaring.length === 0 || unchanged.length !== declaring.length) continue;
    drifted.push({ mapping, artifacts: unchanged });
  }
  return drifted;
}
async function documentationDriftedArtifacts(root2, config, artifacts, baseline2) {
  const stored = baseline2?.implementation_hashes;
  if (!stored) return [];
  const baselineArtifactHashes = new Map((baseline2?.artifacts ?? []).map((entry) => [entry.id, entry.hash]));
  const current = await collectMappingHashes(root2, config, artifacts);
  const drifted = [];
  for (const artifact2 of artifacts) {
    if (artifact2.implementation.length === 0) continue;
    const baselineHash = baselineArtifactHashes.get(artifact2.id);
    if (baselineHash === void 0 || baselineHash === artifact2.hash) continue;
    const observed = artifact2.implementation.filter((mapping) => stored[mapping] !== void 0);
    if (observed.length === 0) continue;
    if (!observed.every((mapping) => current[mapping] !== void 0 && current[mapping] === stored[mapping])) continue;
    drifted.push({ artifact: artifact2, mappings: [...observed].sort() });
  }
  return drifted.sort((a, b2) => a.artifact.id.localeCompare(b2.artifact.id));
}
