function allowedRoots(root2, config) {
  return [root2, ...config.implementation_sources.map((source) => path16.resolve(root2, source.path))];
}
async function executionsForFlow(root2, flowId) {
  const directory = projectPaths(root2).executions;
  if (!await pathExists(directory)) return [];
  const files = (await readdir3(directory)).filter((name) => name.endsWith(".json")).sort();
  const records = [];
  for (const name of files) {
    try {
      const candidate = await readJson(path16.join(directory, name));
      if (isExecutionRecord(candidate) && candidate.flow_id === flowId) records.push(candidate);
    } catch {
    }
  }
  return records;
}
async function runCommand(command, cwd) {
  const started = (/* @__PURE__ */ new Date()).toISOString();
  return new Promise((resolve3) => {
    const child = spawn(command.command, { cwd, shell: true, env: process.env });
    let output = "";
    child.stdout.on("data", (chunk) => {
      output += chunk.toString();
    });
    child.stderr.on("data", (chunk) => {
      output += chunk.toString();
    });
    child.on("error", (error) => resolve3({ exitCode: 1, output: `${output}
${String(error)}`, started, ended: (/* @__PURE__ */ new Date()).toISOString() }));
    child.on("close", (code) => resolve3({ exitCode: code ?? 1, output, started, ended: (/* @__PURE__ */ new Date()).toISOString() }));
  });
}
async function executeVerificationUnlocked(root2, config, levels) {
  const state = await loadCurrentState(root2);
  const flow2 = await loadActiveFlow(root2);
  if (!flow2 || flow2.type !== "evolution" && flow2.type !== "reconciliation") throw new SdlcError("Verification execution is only allowed inside Product Evolution or Reconciliation.");
  const roots = allowedRoots(root2, config);
  const records = [];
  const planned = [];
  for (const level of levels) {
    for (const definition of config.verification[level]) {
      const cwd = path16.resolve(root2, definition.cwd);
      const checks = await Promise.all(roots.map(async (allowed) => {
        try {
          return await isRealPathWithin(allowed, cwd);
        } catch {
          return false;
        }
      }));
      if (!checks.some(Boolean)) throw new SdlcError(`Verification cwd is missing or outside configured sources: ${definition.cwd}`);
      planned.push({ level, definition, cwd });
    }
  }
  const priorForFlow = await executionsForFlow(root2, flow2.id);
  for (const { level, definition, cwd } of planned) {
    const sourceSnapshotBefore = await sourceSnapshotHash(cwd);
    const prior = priorForFlow.find((record3) => record3.command_id === definition.id && record3.command === definition.command && record3.source_snapshot_hash === sourceSnapshotBefore);
    if (prior) {
      records.push(prior);
      continue;
    }
    const id2 = formatId("EXEC", state.next_execution);
    const logFile = path16.join(projectPaths(root2).executions, `${id2}.log`);
    const recordFile = path16.join(projectPaths(root2).executions, `${id2}.json`);
    const resultFile = path16.join(root2, "04-verification", "results", `RESULT-${id2}.md`);
    if (await pathExists(logFile) || await pathExists(recordFile) || await pathExists(resultFile)) throw new SdlcError(`Execution ID ${id2} is already reserved; repair state without overwriting provenance.`);
    await prepareSafeManagedPath(root2, logFile);
    await prepareSafeManagedPath(root2, recordFile);
    await prepareSafeManagedPath(root2, resultFile);
    state.next_execution += 1;
    await saveCurrentState(root2, state);
    const sourceCommit = gitCommit(cwd);
    const sourceSnapshot = sourceSnapshotBefore;
    const result = await runCommand(definition, cwd);
    const record2 = {
      schema_version: 1,
      id: id2,
      flow_id: flow2.id,
      level,
      command_id: definition.id,
      command: definition.command,
      cwd: definition.cwd,
      started_at: result.started,
      ended_at: result.ended,
      exit_code: result.exitCode,
      output_hash: sha256(result.output),
      output_file: `.ai-saas-sdlc/executions/${id2}.log`,
      git_commit: sourceCommit,
      source_snapshot_hash: sourceSnapshot
    };
    await prepareSafeManagedPath(root2, logFile);
    await prepareSafeManagedPath(root2, recordFile);
    await prepareSafeManagedPath(root2, resultFile);
    await writeFile5(logFile, result.output, "utf8");
    await writeJsonAtomic(recordFile, record2);
    await writeFile5(resultFile, renderResultArtifact(record2, flow2.change_id ?? flow2.id), "utf8");
    records.push(record2);
  }
  return records;
}
async function executeVerification(root2, config, levels) {
  return withProjectLock(root2, () => executeVerificationUnlocked(root2, config, levels));
}

