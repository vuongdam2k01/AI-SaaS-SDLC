// src/core/implementation-snapshot.ts
import { execFileSync } from "node:child_process";
import { createHash as createHash2 } from "node:crypto";
import { lstat as lstat2, readFile as readFile5, readlink, realpath as realpath2, stat } from "node:fs/promises";
import path5 from "node:path";
function git(cwd, args, optional = false) {
  try {
    return execFileSync("git", args, { cwd, stdio: ["ignore", "pipe", "ignore"], maxBuffer: 50 * 1024 * 1024 });
  } catch (error) {
    if (optional) return Buffer.alloc(0);
    throw new SdlcError(`Configured implementation source is not a readable Git worktree: ${cwd} (${String(error)})`);
  }
}
function digest(value) {
  return createHash2("sha256").update(value).digest("hex");
}
async function untrackedHashes(repository, pathspecs) {
  const names = git(repository, ["ls-files", "--others", "--exclude-standard", "-z", "--", ...pathspecs]).toString("utf8").split("\0").filter(Boolean).sort();
  const result = [];
  for (const name of names) {
    const file = path5.resolve(repository, name);
    if (!isWithin(repository, file)) throw new SdlcError(`Git returned an unsafe implementation path: ${name}`);
    const info = await lstat2(file);
    const content = info.isSymbolicLink() ? Buffer.from(await readlink(file)) : info.isFile() ? await readFile5(file) : Buffer.alloc(0);
    result.push([toPosix(name), digest(content)]);
  }
  return result;
}
async function filesystemState(resolved, exclusions) {
  const info = await stat(resolved);
  if (!info.isDirectory()) return { kind: "file", hash: digest(await readFile5(resolved)) };
  const names = await (0, import_fast_glob2.default)("**/*", {
    cwd: resolved,
    dot: true,
    onlyFiles: false,
    followSymbolicLinks: false,
    ignore: ["**/.git/**", "**/node_modules/**"]
  });
  const entries = [];
  for (const name of names.sort()) {
    const file = path5.resolve(resolved, name);
    if (!isWithin(resolved, file)) throw new SdlcError(`Filesystem snapshot escaped its implementation source: ${name}`);
    if (exclusions.some((excluded) => isWithin(excluded, file))) continue;
    const item = await lstat2(file);
    if (item.isSymbolicLink()) entries.push([toPosix(name), "link", digest(await readlink(file))]);
    else if (item.isFile()) entries.push([toPosix(name), "file", digest(await readFile5(file))]);
  }
  return { kind: "filesystem", entries };
}
async function pathState(configured, label, exclusions = []) {
  const resolved = await realpath2(configured).catch(() => {
    throw new SdlcError(`Snapshot source is missing: ${label}`);
  });
  const scopedExclusions = exclusions.map((value) => path5.resolve(value)).filter((value) => isWithin(resolved, value));
  const context = (await stat(resolved)).isDirectory() ? resolved : path5.dirname(resolved);
  const repository = git(context, ["rev-parse", "--show-toplevel"], true).toString("utf8").trim();
  if (!repository) return filesystemState(resolved, scopedExclusions);
  if (!isWithin(repository, resolved)) throw new SdlcError(`Snapshot source is outside its Git worktree: ${label}`);
  const relative = toPosix(path5.relative(repository, resolved));
  const pathspec = relative || ".";
  const pathspecs = [pathspec, ...scopedExclusions.map((value) => `:(exclude,top)${toPosix(path5.relative(repository, value))}`)];
  const headObject = git(repository, ["rev-parse", "--verify", relative ? `HEAD:${relative}` : "HEAD^{tree}"], true).toString("utf8").trim() || "unborn-or-untracked";
  return {
    kind: "git",
    head_object: headObject,
    status: digest(git(repository, ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--", ...pathspecs])),
    staged: digest(git(repository, ["diff", "--cached", "--no-ext-diff", "--binary", "--", ...pathspecs])),
    working: digest(git(repository, ["diff", "--no-ext-diff", "--binary", "--", ...pathspecs])),
    untracked: await untrackedHashes(repository, pathspecs)
  };
}
async function sourceSnapshotHash(target) {
  return digest(stableJson(await pathState(path5.resolve(target), target)));
}
async function implementationSnapshotHash(root2) {
  const config = await loadConfig(root2);
  const engineOwned = [path5.join(root2, ".ai-saas-sdlc"), path5.join(root2, "generated"), path5.join(root2, "04-verification", "results")];
  const states = [];
  for (const source of [...config.implementation_sources].sort((a, b) => a.id.localeCompare(b.id))) {
    states.push({ id: source.id, path: source.path, state: await pathState(path5.resolve(root2, source.path), `${source.id} (${source.path})`, engineOwned) });
  }
  return digest(stableJson(states));
}
